{
  "type": "object",
  "properties": {
    "schema_version": {
      "$ref": "#/$defs/SchemaVersion"
    },
    "namespace": {
      "type": "string"
    },
    "generation": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "settings": {
      "$ref": "#/$defs/NamespaceSettings",
      "description": "Fixed for the life of the namespace: every generation repeats the\nsettings the namespace was created with."
    },
    "fixed_grants": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "description": "Source-wide fixed grants: the hashed reader tokens of every source with\n`permissions = \"fixed\"`. Rows of other sources carry their own readers."
    },
    "row_acl_sequence": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0,
      "description": "Old pins predating a row-ACL change cannot authorize with their old rows."
    },
    "retired_sources": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/RetiredSource"
      },
      "description": "Retired sources: readers deny them at once, the committer\nrejects their envelopes, and a restore cannot bring them back. An\nentry is never removed."
    },
    "read_only": {
      "type": "boolean",
      "description": "The namespace is frozen: API writes and connector syncs are refused\nwhile it stays readable. An envelope that was prepared before the\nswitch is still committed. Set only in a policy of major 4, which a\nbuild that does not know the switch refuses instead of writing."
    }
  },
  "required": [
    "schema_version",
    "namespace",
    "generation",
    "settings",
    "fixed_grants"
  ],
  "description": "Immutable policy generation used by the reader's admission path.",
  "title": "PolicyArtifact",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "SchemaVersion": {
      "description": "Contract schema version `<major>.<minor>`. Readers accept any minor of their major and reject other majors.",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "NamespaceSettings": {
      "type": "object",
      "properties": {
        "embedding": {
          "$ref": "#/$defs/EmbeddingIdentity"
        },
        "fts": {
          "$ref": "#/$defs/FtsSettings"
        },
        "dense_rq_bits": {
          "type": "integer",
          "format": "uint8",
          "minimum": 0,
          "maximum": 255,
          "description": "RaBitQ bits per dimension of the vector index."
        },
        "dense_partition_rows": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "description": "Target rows per partition of the vector index."
        },
        "retrieval": {
          "$ref": "#/$defs/RetrievalSettings"
        },
        "composition": {
          "$ref": "#/$defs/CompositionSettings"
        },
        "rerank": {
          "anyOf": [
            {
              "$ref": "#/$defs/RerankSettings"
            },
            {
              "type": "null"
            }
          ]
        },
        "attributes": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/AttributeType"
          },
          "description": "The typed attributes the namespace declares when it is created. Each is\na nullable column with its own index from the first publication."
        },
        "write_api": {
          "anyOf": [
            {
              "$ref": "#/$defs/WriteApiSettings"
            },
            {
              "type": "null"
            }
          ],
          "description": "Present: the namespace is written through the HTTP API and takes no\nconnector source. Fixed with the rest of the settings."
        }
      },
      "required": [
        "embedding",
        "fts",
        "dense_rq_bits",
        "dense_partition_rows",
        "retrieval",
        "composition"
      ],
      "description": "The index and retrieval settings a namespace is created with and keeps for\nits life. The process configuration only supplies them when the namespace is\ncreated; every reader and writer afterwards takes them from the namespace's\npolicy artifact, which each content manifest pins."
    },
    "EmbeddingIdentity": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string"
        },
        "dimensions": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "fingerprint": {
          "type": "string",
          "description": "Digest of the model settings and text transformation (prefix,\nnormalization) that keys the embedding cache."
        },
        "settings": {
          "$ref": "#/$defs/EmbeddingSettings"
        }
      },
      "required": [
        "model",
        "dimensions",
        "fingerprint",
        "settings"
      ],
      "description": "The embedding identity bound into envelopes and publications."
    },
    "EmbeddingSettings": {
      "type": "object",
      "properties": {
        "api_style": {
          "$ref": "#/$defs/EmbeddingApiStyle"
        },
        "prefix": {
          "type": "string",
          "maxLength": 4096,
          "x-maxUtf8Bytes": 4096
        },
        "roles": {
          "$ref": "#/$defs/EmbeddingRoles"
        },
        "send_dimensions": {
          "type": "boolean"
        }
      },
      "required": [
        "api_style",
        "prefix",
        "roles",
        "send_dimensions"
      ],
      "description": "Vector-affecting settings recorded with a publication's model/dimensions."
    },
    "EmbeddingApiStyle": {
      "type": "string",
      "enum": [
        "openai-compatible"
      ],
      "description": "Fixed protocol identity recorded in persisted embedding settings."
    },
    "EmbeddingRoles": {
      "type": "object",
      "properties": {
        "document": {
          "$ref": "#/$defs/EmbeddingRole"
        },
        "query": {
          "$ref": "#/$defs/EmbeddingRole"
        }
      },
      "required": [
        "document",
        "query"
      ],
      "description": "Persisted role transformations accept future minor-version additions.\nConfiguration uses strict types at its TOML boundary."
    },
    "EmbeddingRole": {
      "type": "object",
      "properties": {
        "prefix": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4096,
          "x-maxUtf8Bytes": 4096
        },
        "input_type": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 128,
          "x-maxUtf8Bytes": 128
        }
      }
    },
    "FtsSettings": {
      "type": "object",
      "properties": {
        "tokenizer": {
          "type": "string"
        },
        "max_token_length": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "lowercase": {
          "type": "boolean"
        },
        "stem": {
          "type": "boolean"
        },
        "remove_stop_words": {
          "type": "boolean"
        },
        "ascii_folding": {
          "type": "boolean"
        },
        "with_position": {
          "type": "boolean",
          "description": "Positional postings; false while there is no phrase scoring."
        }
      },
      "required": [
        "tokenizer",
        "max_token_length",
        "lowercase",
        "stem",
        "remove_stop_words",
        "ascii_folding",
        "with_position"
      ],
      "description": "FTS analyzer settings, part of the publication identity."
    },
    "RetrievalSettings": {
      "type": "object",
      "properties": {
        "rescore_depth": {
          "$ref": "#/$defs/RescoreSettings"
        },
        "dense_weight": {
          "type": "number",
          "format": "double"
        },
        "dense_candidates": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "lexical_candidates": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "source_cap": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "max_documents": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        }
      },
      "required": [
        "dense_weight",
        "dense_candidates",
        "lexical_candidates",
        "source_cap",
        "max_documents"
      ],
      "description": "The persisted copy of [`RetrievalConfig`]."
    },
    "RescoreSettings": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "legacy"
            }
          },
          "required": [
            "mode"
          ]
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "fixed"
            },
            "candidates": {
              "type": "integer",
              "format": "uint",
              "minimum": 0
            }
          },
          "required": [
            "mode",
            "candidates"
          ]
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "adaptive"
            },
            "min_candidates": {
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "max_candidates": {
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "min_gap": {
              "type": "number",
              "format": "double"
            }
          },
          "required": [
            "mode",
            "min_candidates",
            "max_candidates",
            "min_gap"
          ]
        }
      ],
      "description": "The persisted copy of [`RescoreDepth`]."
    },
    "CompositionSettings": {
      "type": "object",
      "properties": {
        "fusion": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "dense": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "lexical": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        }
      },
      "required": [
        "fusion",
        "dense",
        "lexical"
      ],
      "description": "The persisted copy of [`Composition`]."
    },
    "RerankSettings": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string"
        },
        "candidates": {
          "type": "integer",
          "format": "uint",
          "minimum": 1,
          "description": "Authorized composed documents to rerank before the request limit.",
          "maximum": 75
        },
        "weight": {
          "type": "number",
          "format": "double",
          "description": "Logistic population-z score blend; 1 uses raw reranker order, 0 fusion order.",
          "minimum": 0,
          "maximum": 1
        },
        "text_chars": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 200,
          "description": "Per-candidate text bound in characters; absent sends the whole record.",
          "maximum": 32768
        }
      },
      "required": [
        "model",
        "candidates",
        "weight"
      ],
      "description": "What of a reranker decides results: recorded in the namespace when it is\ncreated. The endpoint, credential, spend caps and deadline stay process\nconfiguration ([`RerankConfig`]). Persisted types accept the fields a newer\nminor version adds, unlike their configuration counterparts."
    },
    "AttributeType": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "string",
            "bool"
          ]
        },
        {
          "type": "string",
          "const": "int",
          "description": "64-bit signed integer."
        },
        {
          "type": "string",
          "const": "float",
          "description": "64-bit float."
        },
        {
          "type": "string",
          "const": "datetime",
          "description": "An RFC 3339 string in requests, stored as UTC microseconds."
        },
        {
          "type": "string",
          "const": "uint",
          "description": "64-bit unsigned integer."
        },
        {
          "type": "string",
          "const": "uuid",
          "description": "A UUID as 8-4-4-4-12 hexadecimal digits in requests, stored in 16 bytes."
        },
        {
          "type": "string",
          "const": "bytes",
          "description": "Base64 in requests. Stored, never filtered, sorted or indexed."
        },
        {
          "type": "object",
          "properties": {
            "array": {
              "$ref": "#/$defs/ElementType"
            }
          },
          "required": [
            "array"
          ],
          "additionalProperties": false,
          "description": "A list of values of one scalar type, written `{\"array\": \"string\"}`."
        }
      ],
      "description": "The type of an attribute."
    },
    "ElementType": {
      "type": "string",
      "enum": [
        "string",
        "int",
        "float",
        "bool",
        "datetime",
        "uint",
        "uuid"
      ],
      "description": "The type of the elements of an array: every scalar type but `bytes`."
    },
    "WriteApiSettings": {
      "type": "object",
      "properties": {
        "text_attribute": {
          "type": "string",
          "description": "The key of a row that holds its text: embedded, full-text indexed and\nreturned as the content of the record. It is not a typed attribute and\nnot one of `attributes`.",
          "default": "text"
        },
        "open": {
          "type": "boolean",
          "description": "`false`: a row is readable by the reader tokens it names, and a row\nthat names none by nobody. `true`: every authenticated subject of the\ndeployment reads every row.",
          "default": false
        }
      },
      "description": "How a namespace written through the HTTP API stores and shows its rows. Fixed\nfor the life of the namespace."
    },
    "RetiredSource": {
      "type": "object",
      "properties": {
        "retired_at": {
          "type": "string",
          "format": "date-time"
        },
        "purged_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "required": [
        "retired_at"
      ],
      "description": "When a source was retired and, once its data was removed, purged."
    }
  },
  "x-fyrr-contract": "policy-artifact",
  "x-fyrr-schema-version": "3.1"
}
