{
  "type": "object",
  "properties": {
    "schema_version": {
      "$ref": "#/$defs/SchemaVersion"
    },
    "namespace": {
      "type": "string"
    },
    "publication_id": {
      "type": "string"
    },
    "sequence": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0,
      "description": "Monotonic content publication sequence (listing watermarks use it)."
    },
    "previous_publication_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "lance_version": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0,
      "description": "Exact Lance version, including its FTS index."
    },
    "committed_at": {
      "type": "string",
      "format": "date-time"
    },
    "maintenance_completed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "Last completed maintenance, inherited by ordinary publications."
    },
    "embedding": {
      "$ref": "#/$defs/EmbeddingIdentity"
    },
    "chunk_profile": {
      "$ref": "#/$defs/ChunkProfileIdentity"
    },
    "fts": {
      "$ref": "#/$defs/FtsSettings"
    },
    "dense_rq_bits": {
      "type": "integer",
      "format": "uint8",
      "minimum": 0,
      "maximum": 255,
      "description": "RaBitQ bits per dimension of the vector index."
    },
    "dense_partition_rows": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0,
      "description": "Target rows per partition of the vector index."
    },
    "retrieval_policy_digest": {
      "type": "string",
      "description": "Digest of the retrieval policy, including the result composition."
    },
    "indexes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/IndexIdentity"
      }
    },
    "attributes": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/AttributeType"
      },
      "description": "The typed attributes of this version: each is a nullable column with an\nindex of its own among `indexes`."
    },
    "files": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/FileRef"
      },
      "description": "Immutable files of this version, relative to the dataset root."
    },
    "envelope_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Envelopes this publication committed."
    },
    "lineage": {
      "$ref": "#/$defs/CommitLineage",
      "description": "Exact Lance transactions made by the leased holder."
    },
    "identity": {
      "$ref": "#/$defs/GenerationPointer",
      "description": "Pins immutable membership/container inputs through the identity artifact."
    },
    "policy": {
      "$ref": "#/$defs/GenerationPointer"
    },
    "rejected_envelope_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cursor_rewinds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Immutable restore rewind marker paths; visible only through this publication."
    },
    "incarnation": {
      "type": "string",
      "description": "The incarnation of the namespace that published this version, copied\nfrom the serving head."
    },
    "envelope_evidence": {
      "anyOf": [
        {
          "$ref": "#/$defs/EnvelopeEvidence"
        },
        {
          "type": "null"
        }
      ],
      "description": "Which envelopes this publication and every older one committed or\nrejected, so that the newest manifest is enough to tell. Absent from\nmanifests written before it existed: a reader then walks the chain."
    },
    "stats": {
      "anyOf": [
        {
          "$ref": "#/$defs/PublicationStats"
        },
        {
          "type": "null"
        }
      ],
      "description": "What the version holds. Absent from manifests written before 4.1."
    }
  },
  "required": [
    "schema_version",
    "namespace",
    "publication_id",
    "sequence",
    "lance_version",
    "committed_at",
    "embedding",
    "chunk_profile",
    "fts",
    "dense_rq_bits",
    "dense_partition_rows",
    "retrieval_policy_digest",
    "indexes",
    "files",
    "envelope_ids",
    "lineage",
    "identity",
    "policy",
    "incarnation"
  ],
  "description": "A content publication manifest.",
  "title": "ContentManifest",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "SchemaVersion": {
      "description": "Contract schema version `<major>.<minor>`. Readers accept any minor of their major and reject other majors.",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "EmbeddingIdentity": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string"
        },
        "dimensions": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "fingerprint": {
          "type": "string",
          "description": "Digest of the model settings and text transformation (prefix,\nnormalization) that keys the embedding cache."
        },
        "settings": {
          "$ref": "#/$defs/EmbeddingSettings"
        }
      },
      "required": [
        "model",
        "dimensions",
        "fingerprint",
        "settings"
      ],
      "description": "The embedding identity bound into envelopes and publications."
    },
    "EmbeddingSettings": {
      "type": "object",
      "properties": {
        "api_style": {
          "$ref": "#/$defs/EmbeddingApiStyle"
        },
        "prefix": {
          "type": "string",
          "maxLength": 4096,
          "x-maxUtf8Bytes": 4096
        },
        "roles": {
          "$ref": "#/$defs/EmbeddingRoles"
        },
        "send_dimensions": {
          "type": "boolean"
        }
      },
      "required": [
        "api_style",
        "prefix",
        "roles",
        "send_dimensions"
      ],
      "description": "Vector-affecting settings recorded with a publication's model/dimensions."
    },
    "EmbeddingApiStyle": {
      "type": "string",
      "enum": [
        "openai-compatible"
      ],
      "description": "Fixed protocol identity recorded in persisted embedding settings."
    },
    "EmbeddingRoles": {
      "type": "object",
      "properties": {
        "document": {
          "$ref": "#/$defs/EmbeddingRole"
        },
        "query": {
          "$ref": "#/$defs/EmbeddingRole"
        }
      },
      "required": [
        "document",
        "query"
      ],
      "description": "Persisted role transformations accept future minor-version additions.\nConfiguration uses strict types at its TOML boundary."
    },
    "EmbeddingRole": {
      "type": "object",
      "properties": {
        "prefix": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4096,
          "x-maxUtf8Bytes": 4096
        },
        "input_type": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 128,
          "x-maxUtf8Bytes": 128
        }
      }
    },
    "ChunkProfileIdentity": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "max_unit_bytes": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "overlap_bytes": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "digest": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "max_unit_bytes",
        "overlap_bytes",
        "digest"
      ],
      "description": "The chunk profile identity."
    },
    "FtsSettings": {
      "type": "object",
      "properties": {
        "tokenizer": {
          "type": "string"
        },
        "max_token_length": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "lowercase": {
          "type": "boolean"
        },
        "stem": {
          "type": "boolean"
        },
        "remove_stop_words": {
          "type": "boolean"
        },
        "ascii_folding": {
          "type": "boolean"
        },
        "with_position": {
          "type": "boolean",
          "description": "Positional postings; false while there is no phrase scoring."
        }
      },
      "required": [
        "tokenizer",
        "max_token_length",
        "lowercase",
        "stem",
        "remove_stop_words",
        "ascii_folding",
        "with_position"
      ],
      "description": "FTS analyzer settings, part of the publication identity."
    },
    "IndexIdentity": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "description": "`ivf_rq`, `fts`, `btree`, `bitmap` or `label_list`."
        },
        "column": {
          "type": "string"
        },
        "uuid": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "kind",
        "column",
        "uuid"
      ],
      "description": "One index of the published version."
    },
    "AttributeType": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "string",
            "bool"
          ]
        },
        {
          "type": "string",
          "const": "int",
          "description": "64-bit signed integer."
        },
        {
          "type": "string",
          "const": "float",
          "description": "64-bit float."
        },
        {
          "type": "string",
          "const": "datetime",
          "description": "An RFC 3339 string in requests, stored as UTC microseconds."
        },
        {
          "type": "string",
          "const": "uint",
          "description": "64-bit unsigned integer."
        },
        {
          "type": "string",
          "const": "uuid",
          "description": "A UUID as 8-4-4-4-12 hexadecimal digits in requests, stored in 16 bytes."
        },
        {
          "type": "string",
          "const": "bytes",
          "description": "Base64 in requests. Stored, never filtered, sorted or indexed."
        },
        {
          "type": "object",
          "properties": {
            "array": {
              "$ref": "#/$defs/ElementType"
            }
          },
          "required": [
            "array"
          ],
          "additionalProperties": false,
          "description": "A list of values of one scalar type, written `{\"array\": \"string\"}`."
        }
      ],
      "description": "The type of an attribute."
    },
    "ElementType": {
      "type": "string",
      "enum": [
        "string",
        "int",
        "float",
        "bool",
        "datetime",
        "uint",
        "uuid"
      ],
      "description": "The type of the elements of an array: every scalar type but `bytes`."
    },
    "FileRef": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "size_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "path",
        "size_bytes"
      ],
      "description": "A file with its size, for accounting and the mirror."
    },
    "CommitLineage": {
      "type": "object",
      "properties": {
        "holder": {
          "type": "string"
        },
        "epoch": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "base_version": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "recovery_version": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0,
          "description": "A recovery Restore supersedes unpublished history before this boundary."
        },
        "transactions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LineageTransaction"
          }
        }
      },
      "required": [
        "holder",
        "epoch",
        "base_version",
        "transactions"
      ],
      "description": "Publication-local fencing evidence, immutable with the content manifest."
    },
    "LineageTransaction": {
      "type": "object",
      "properties": {
        "version": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "transaction_id": {
          "type": "string"
        }
      },
      "required": [
        "version",
        "transaction_id"
      ],
      "description": "Identity of one actual Lance transaction, never an inferred version range."
    },
    "GenerationPointer": {
      "type": "object",
      "properties": {
        "generation": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "object": {
          "type": "string",
          "description": "Object key, relative to the namespace root."
        },
        "digest": {
          "type": "string"
        }
      },
      "required": [
        "generation",
        "object",
        "digest"
      ],
      "description": "Points at one immutable generation of a policy or identity artifact."
    },
    "EnvelopeEvidence": {
      "type": "object",
      "properties": {
        "checkpoint": {
          "$ref": "#/$defs/GenerationPointer",
          "description": "The [`EnvelopeCheckpoint`] of an older publication."
        },
        "applied_since": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Envelopes committed after the checkpoint, this publication's included."
        },
        "rejected_since": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Envelopes rejected after the checkpoint, this publication's included."
        }
      },
      "required": [
        "checkpoint",
        "applied_since",
        "rejected_since"
      ],
      "description": "The envelope outcomes of a publication chain up to one manifest: an\nimmutable checkpoint of the older ones, and the few since."
    },
    "PublicationStats": {
      "type": "object",
      "properties": {
        "rows": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "description": "Live rows, deleted ones not counted."
        },
        "logical_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "description": "Bytes of the data files of those rows, indexes and deletion files not counted."
        },
        "first_published_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "description": "When the namespace's first content publication was committed, carried\nforward by every later one. Absent when the namespace was published\nbefore 4.1: that time is not known."
        }
      },
      "required": [
        "rows",
        "logical_bytes"
      ],
      "description": "The size of a published version and when its namespace was first published."
    }
  },
  "x-fyrr-contract": "content-manifest",
  "x-fyrr-schema-version": "5.0"
}
