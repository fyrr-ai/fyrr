{
  "type": "object",
  "properties": {
    "schema_version": {
      "$ref": "#/$defs/SchemaVersion"
    },
    "envelope_id": {
      "type": "string",
      "description": "Deterministic ID from [`envelope_id`]; a repeated sync is a no-op."
    },
    "namespace": {
      "type": "string"
    },
    "source_id": {
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/SyncKind"
    },
    "sequence": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0,
      "description": "Per-source, per-kind sequence number."
    },
    "rejection_generation": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0,
      "description": "Rejection generation of this source and kind; part of the ID so\nre-fetched changes after a rejection form a new envelope."
    },
    "cursor": {
      "$ref": "#/$defs/CursorStep",
      "description": "Connector cursors before and after the envelope's changes."
    },
    "advances_cursor": {
      "type": "boolean",
      "description": "False when the envelope leaves the cursor where it was, absent or opaque."
    },
    "base_head": {
      "anyOf": [
        {
          "$ref": "#/$defs/BaseHead"
        },
        {
          "type": "null"
        }
      ],
      "description": "The serving head the worker prepared against; `null` on a namespace\nwithout a publication."
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Written to the microsecond, always: the encoding of an envelope is as\nlong whenever it is written."
    },
    "lease_generation": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0,
      "description": "The generation of the cursor lease its worker held; part of the ID of a\ncontent or permissions envelope, so two workers never write the same\none. Zero for members and listings, which are not chained."
    },
    "previous": {
      "type": [
        "string",
        "null"
      ],
      "description": "The envelope of its source and kind this one follows, from the cursor\nof its worker; none for the first. The committer applies only the\nenvelopes that chain back from the one the cursor confirmed."
    },
    "payload": {
      "$ref": "#/$defs/EnvelopePayload"
    }
  },
  "required": [
    "schema_version",
    "envelope_id",
    "namespace",
    "source_id",
    "kind",
    "sequence",
    "rejection_generation",
    "cursor",
    "advances_cursor",
    "created_at",
    "payload"
  ],
  "description": "A prepared envelope.",
  "title": "PreparedEnvelope",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "SchemaVersion": {
      "description": "Contract schema version `<major>.<minor>`. Readers accept any minor of their major and reject other majors.",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "SyncKind": {
      "type": "string",
      "enum": [
        "content",
        "permissions",
        "members",
        "reconcile"
      ],
      "description": "Which of a source's independent syncs produced a batch."
    },
    "CursorStep": {
      "type": "object",
      "properties": {
        "start": {
          "type": [
            "string",
            "null"
          ],
          "description": "Cursor before this batch; `null` for a first or reset sync."
        },
        "end": {
          "type": "string",
          "description": "Opaque cursor after this batch, at most 16 KiB."
        }
      },
      "required": [
        "end"
      ],
      "description": "One cursor step: the cursor the batch started from and the cursor after it."
    },
    "BaseHead": {
      "type": "object",
      "properties": {
        "content_publication_id": {
          "type": "string"
        },
        "content_sequence": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "lance_version": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "content_publication_id",
        "content_sequence",
        "lance_version"
      ],
      "description": "The head an envelope was prepared against."
    },
    "EnvelopePayload": {
      "oneOf": [
        {
          "$ref": "#/$defs/ContentPayload",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "content"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "$ref": "#/$defs/PermissionsPayload",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "permissions"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "$ref": "#/$defs/MembersPayload",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "members"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "$ref": "#/$defs/ReconcilePayload",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "reconcile"
            }
          },
          "required": [
            "type"
          ]
        }
      ],
      "description": "Kind-specific envelope content, tagged by `type`."
    },
    "EmbeddingIdentity": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string"
        },
        "dimensions": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "fingerprint": {
          "type": "string",
          "description": "Digest of the model settings and text transformation (prefix,\nnormalization) that keys the embedding cache."
        },
        "settings": {
          "$ref": "#/$defs/EmbeddingSettings"
        }
      },
      "required": [
        "model",
        "dimensions",
        "fingerprint",
        "settings"
      ],
      "description": "The embedding identity bound into envelopes and publications."
    },
    "EmbeddingSettings": {
      "type": "object",
      "properties": {
        "api_style": {
          "$ref": "#/$defs/EmbeddingApiStyle"
        },
        "prefix": {
          "type": "string",
          "maxLength": 4096,
          "x-maxUtf8Bytes": 4096
        },
        "roles": {
          "$ref": "#/$defs/EmbeddingRoles"
        },
        "send_dimensions": {
          "type": "boolean"
        }
      },
      "required": [
        "api_style",
        "prefix",
        "roles",
        "send_dimensions"
      ],
      "description": "Vector-affecting settings recorded with a publication's model/dimensions."
    },
    "EmbeddingApiStyle": {
      "type": "string",
      "enum": [
        "openai-compatible"
      ],
      "description": "Fixed protocol identity recorded in persisted embedding settings."
    },
    "EmbeddingRoles": {
      "type": "object",
      "properties": {
        "document": {
          "$ref": "#/$defs/EmbeddingRole"
        },
        "query": {
          "$ref": "#/$defs/EmbeddingRole"
        }
      },
      "required": [
        "document",
        "query"
      ],
      "description": "Persisted role transformations accept future minor-version additions.\nConfiguration uses strict types at its TOML boundary."
    },
    "EmbeddingRole": {
      "type": "object",
      "properties": {
        "prefix": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4096,
          "x-maxUtf8Bytes": 4096
        },
        "input_type": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 128,
          "x-maxUtf8Bytes": 128
        }
      }
    },
    "ChunkProfileIdentity": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "max_unit_bytes": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "overlap_bytes": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "digest": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "max_unit_bytes",
        "overlap_bytes",
        "digest"
      ],
      "description": "The chunk profile identity."
    },
    "EnvelopeDocument": {
      "type": "object",
      "properties": {
        "root_id": {
          "type": "string"
        },
        "intent": {
          "$ref": "#/$defs/DocumentIntent"
        },
        "source_revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "revision_order": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "expected_prior_revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "permission_revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "records": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "description": "Records written for this document (0 for a delete or a patch)."
        },
        "patch": {
          "anyOf": [
            {
              "$ref": "#/$defs/DocumentPatch"
            },
            {
              "type": "null"
            }
          ],
          "description": "What a `Patch` writes; present for that intent only."
        },
        "condition": {
          "anyOf": [
            {
              "$ref": "#/$defs/Filter"
            },
            {
              "type": "null"
            }
          ],
          "description": "A condition the stored document must meet when the committer applies\nthis intent, else it is skipped and writes nothing. A document that is\nnot there skips a `Patch` or a `Delete` and meets it for a `Replace`."
        }
      },
      "required": [
        "root_id",
        "intent",
        "records"
      ],
      "description": "Replacement or delete intent for one document."
    },
    "DocumentIntent": {
      "oneOf": [
        {
          "type": "string",
          "const": "replace",
          "description": "Atomically replace every record of the document."
        },
        {
          "type": "string",
          "const": "delete",
          "description": "Remove every record of the document."
        },
        {
          "type": "string",
          "const": "patch",
          "description": "Write the values of `patch` into the records of an existing document;\na document that does not exist is skipped, never created."
        }
      ],
      "description": "What the committer does with a document."
    },
    "DocumentPatch": {
      "type": "object",
      "properties": {
        "readers": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          },
          "description": "Hashed readers that replace the document's; `null` keeps them."
        },
        "text": {
          "type": [
            "string",
            "null"
          ],
          "description": "The new text of the record; `null` keeps it."
        },
        "vector": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "number",
            "format": "float"
          },
          "description": "The vector of the new text, which replaces the stored one; present\nwith `text` only."
        },
        "attributes": {
          "type": "object",
          "additionalProperties": true,
          "description": "Attribute values by name; a `null` clears the attribute."
        }
      },
      "required": [
        "attributes"
      ],
      "description": "The values a patch writes into the stored records of a document. Every\ncolumn it does not name stays as stored, the vector unless the patch brings\none with the new text."
    },
    "Filter": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "and": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Filter"
              }
            }
          },
          "required": [
            "and"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "or": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Filter"
              }
            }
          },
          "required": [
            "or"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "not": {
              "$ref": "#/$defs/Filter"
            }
          },
          "required": [
            "not"
          ]
        },
        {
          "$ref": "#/$defs/Comparison"
        }
      ],
      "description": "A filter tree: `and` and `or` of one or more filters, `not` of one, or a\ncomparison of a field with a value. At most [`MAX_FILTER_NODES`] nodes in\n[`MAX_FILTER_DEPTH`] levels. It is read from the request in one pass that\nstops at the first bound it exceeds."
    },
    "Comparison": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "field": {
          "type": "string"
        },
        "op": {
          "$ref": "#/$defs/Op"
        },
        "value": true
      },
      "required": [
        "field",
        "op",
        "value"
      ],
      "description": "A field compared with a value; `in` and `not_in` take an array of values.\nThe reader checks the field and the value against the namespace's schema."
    },
    "Op": {
      "type": "string",
      "enum": [
        "eq",
        "ne",
        "in",
        "not_in",
        "lt",
        "lte",
        "gt",
        "gte",
        "contains",
        "not_contains",
        "starts_with",
        "not_starts_with",
        "matches",
        "not_matches",
        "contains_any",
        "contains_all",
        "contains_none"
      ],
      "description": "How a field is compared with a value. `starts_with`, `matches` and their\nnegations test the text of a `string`; `contains` and `not_contains` test\nthe text of a `string` or one element of an array. The last three test the\nelements of an array attribute and apply to nothing else."
    },
    "PreparedFragment": {
      "type": "object",
      "properties": {
        "rows": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FileRef"
          },
          "description": "Data files, relative to the namespace dataset root."
        },
        "lance_fragment": {
          "description": "Lance's own fragment description, opaque to fyrr."
        },
        "digest": {
          "type": "string",
          "description": "SHA-256 of the ordered file bytes."
        }
      },
      "required": [
        "rows",
        "files",
        "lance_fragment",
        "digest"
      ],
      "description": "A Lance fragment written by the worker but not yet committed."
    },
    "FileRef": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "size_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "path",
        "size_bytes"
      ],
      "description": "A file with its size, for accounting and the mirror."
    },
    "QuarantineEntry": {
      "type": "object",
      "properties": {
        "root_digest": {
          "type": "string"
        },
        "revision_digest": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "root_digest",
        "revision_digest",
        "reason"
      ],
      "description": "Value-free diagnostic carried by an immutable envelope, never mutable state."
    },
    "FilterWrites": {
      "type": "object",
      "properties": {
        "source_revision": {
          "type": "string",
          "description": "The revision and its order of the documents the filters match."
        },
        "revision_order": {
          "type": "integer",
          "format": "int64"
        },
        "delete": {
          "anyOf": [
            {
              "$ref": "#/$defs/Filter"
            },
            {
              "type": "null"
            }
          ],
          "description": "The documents to delete."
        },
        "patch": {
          "anyOf": [
            {
              "$ref": "#/$defs/FilterPatch"
            },
            {
              "type": "null"
            }
          ],
          "description": "The documents to patch."
        }
      },
      "required": [
        "source_revision",
        "revision_order"
      ],
      "description": "What an envelope does to the documents that match a filter. Deletes apply\nfirst, then patches, then the documents of the envelope itself, which win\nover a filter for the documents they name, except that a patch by id of a\ndocument the filter deletes finds it deleted."
    },
    "FilterPatch": {
      "type": "object",
      "properties": {
        "filter": {
          "$ref": "#/$defs/Filter"
        },
        "values": {
          "$ref": "#/$defs/DocumentPatch"
        }
      },
      "required": [
        "filter",
        "values"
      ],
      "description": "A patch of every document that matches `filter`. It writes attributes or\nreaders, never a text, which would need a vector of its own per document."
    },
    "ContentPayload": {
      "type": "object",
      "properties": {
        "embedding": {
          "$ref": "#/$defs/EmbeddingIdentity",
          "description": "Embedding model identity used for the fragments."
        },
        "chunk_profile": {
          "$ref": "#/$defs/ChunkProfileIdentity",
          "description": "Chunk profile identity used for the fragments."
        },
        "table_schema_version": {
          "$ref": "#/$defs/SchemaVersion",
          "description": "Version of the namespace table schema the fragments were written in."
        },
        "documents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EnvelopeDocument"
          }
        },
        "fragments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PreparedFragment"
          }
        },
        "quarantined": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/QuarantineEntry"
          }
        },
        "filter_writes": {
          "anyOf": [
            {
              "$ref": "#/$defs/FilterWrites"
            },
            {
              "type": "null"
            }
          ],
          "description": "Deletes and patches of every document that matches a filter, which the\ncommitter evaluates once against the state the envelope is applied to;\nwritten by the write API only."
        }
      },
      "required": [
        "embedding",
        "chunk_profile",
        "table_schema_version",
        "documents",
        "fragments"
      ],
      "description": "Prepared content: per-document intent and the unreferenced Lance fragments\nthat hold the new records."
    },
    "DocumentPermission": {
      "type": "object",
      "properties": {
        "root_id": {
          "type": "string"
        },
        "permission_revision": {
          "type": "string"
        },
        "readers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "containers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "required": [
        "root_id",
        "permission_revision",
        "readers"
      ],
      "description": "The readers of one document from a permission sync."
    },
    "ContainerGrant": {
      "type": "object",
      "properties": {
        "container_id": {
          "type": "string"
        },
        "container_kind": {
          "type": "string",
          "description": "`folder`, `channel`, `project`, `connection` or another container kind."
        },
        "permission_revision": {
          "type": "string"
        },
        "readers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "container_id",
        "container_kind",
        "permission_revision",
        "readers"
      ],
      "description": "Readers granted on a container, resolved like a source grant."
    },
    "PermissionsPayload": {
      "type": "object",
      "properties": {
        "complete_read": {
          "type": "boolean",
          "description": "True on the envelope that ends a read: the read's only envelope, or its\nlast when the read is published in parts. Only such an envelope consumes\nthe rejection markers."
        },
        "documents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DocumentPermission"
          }
        },
        "container_grants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ContainerGrant"
          }
        }
      },
      "required": [
        "complete_read",
        "documents",
        "container_grants"
      ],
      "description": "A permission sync's per-document readers and container grants."
    },
    "MembersPayload": {
      "type": "object",
      "properties": {
        "complete_read": {
          "type": "boolean",
          "description": "True only on the empty envelope that ends a read replacing a rejected\ngeneration; it alone consumes the rejection markers."
        },
        "snapshot_id": {
          "type": "string"
        },
        "snapshot_object": {
          "type": "string",
          "description": "Object key of the snapshot, relative to the namespace root."
        },
        "snapshot_digest": {
          "type": "string"
        },
        "part": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "last": {
          "type": "boolean"
        },
        "principals": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "complete_read",
        "snapshot_id",
        "snapshot_object",
        "snapshot_digest",
        "part",
        "last",
        "principals"
      ],
      "description": "A membership sync's immutable principal snapshot on S3."
    },
    "ReconcilePayload": {
      "type": "object",
      "properties": {
        "listing_id": {
          "type": "string"
        },
        "part": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "last": {
          "type": "boolean"
        },
        "complete": {
          "type": "boolean"
        },
        "watermark": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "description": "The head's content publication sequence when the listing started;\nderived deletes cover only documents published at or before it."
        },
        "root_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "listing_id",
        "part",
        "last",
        "complete",
        "watermark",
        "root_ids"
      ],
      "description": "One part of a full-ID listing."
    }
  },
  "x-fyrr-contract": "prepared-envelope",
  "x-fyrr-schema-version": "6.0"
}
