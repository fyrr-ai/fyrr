# Only what docker/Dockerfile copies; examples are built and installed as
# independent wheels, never in the image build.
*
!Cargo.toml
!LICENSE
!NOTICE
!Cargo.lock
!rust-toolchain.toml
!.cargo/
!crates/
!connectors/
!scripts/lib.sh
!scripts/pins.env
!docker/fyrr-entrypoint
**/.venv
**/__pycache__
**/.pytest_cache
**/.ruff_cache
# Production builds do not compile test modules or consume their fixtures.
crates/*/tests/
crates/*/src/**/tests/
crates/*/src/**/tests.rs
crates/*/src/**/*_tests.rs
connectors/tests/
**/.env
**/.env.*
connectors/dist/
