{
  "name": "fyrr-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run build && bun run preview",
    "build": "bun run content && next build && bun scripts/finalize.ts && bun scripts/check-links.ts",
    "typecheck": "tsc --noEmit",
    "preview": "wrangler dev --port 8486",
    "verify:browser": "node scripts/verify-browser.mjs",
    "lighthouse": "node scripts/lighthouse.mjs",
    "content": "bun scripts/prepare.ts && fumadocs-mdx",
    "deploy": "wrangler deploy",
    "deploy:preview": "wrangler versions upload"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "cheerio": "^1.1.0",
    "fumadocs-core": "16.19.3",
    "fumadocs-mdx": "15.6.2",
    "fumadocs-ui": "16.19.3",
    "geist": "^1.9.2",
    "mdast-util-to-string": "^4.0.0",
    "next": "16.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "remark-gfm": "^4.0.0",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "tailwindcss": "^4.1.0",
    "unified": "^11.0.0",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/mdx": "^2.0.13",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "lighthouse": "^13.6.0",
    "typescript": "^5.9.0",
    "wrangler": "4.162.0"
  },
  "packageManager": "bun@1.4.4"
}
