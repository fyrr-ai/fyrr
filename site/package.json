{
  "name": "fyrr-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run build:preview && bun run preview",
    "build": "bun run content && next build && bun scripts/finalize.ts && bun scripts/check-links.ts",
    "build:preview": "SITE_ALLOW_DRAFT_COMPARE=1 bun run build",
    "typecheck": "tsc --noEmit",
    "audit": "bun audit --ignore GHSA-fc5q-39xc-vjpf",
    "preview": "wrangler dev --port 8486",
    "verify:browser": "node scripts/verify-browser.mjs",
    "verify:compare": "node scripts/verify-compare.mjs",
    "render:banner": "node scripts/render-banner.mjs",
    "test:compare": "bun test scripts/compare.test.ts",
    "content": "bun scripts/prepare.ts && fumadocs-mdx",
    "deploy": "bun scripts/check-compare.ts --publish && wrangler deploy",
    "deploy:preview": "bun scripts/check-compare.ts --publish && wrangler versions upload"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "cheerio": "^1.1.0",
    "fumadocs-core": "16.19.4",
    "fumadocs-mdx": "15.6.3",
    "fumadocs-ui": "16.19.4",
    "geist": "^1.9.2",
    "mdast-util-to-string": "^4.0.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remark-gfm": "^4.0.0",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "tailwindcss": "^4.1.0",
    "unified": "^11.0.0",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@types/mdx": "^2.0.13",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/subset-font": "2.3.0",
    "playwright": "^1.65.1",
    "subset-font": "2.9.0",
    "typescript": "^7.0.2",
    "wrangler": "4.165.0"
  },
  "packageManager": "bun@1.4.4"
}
