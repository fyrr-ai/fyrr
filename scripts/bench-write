#!/usr/bin/env python3
"""Measure write latency and write-to-searchable time of the real HTTP path.

The native `fyrr writer serve` and `fyrr reader serve` run on one storage and
this script only drives them and scores the timings it observes. Every row
carries its own vector, so no embedding call is in the path. For each batch
size it reports p50, p90 and p99 of

  write   the time until `POST /v1/namespaces/{ns}/documents` is answered,
          which is when the head that readers serve holds the write;
  read    a `strong` fetch of the batch's last row, sent when the answer
          arrives, until that row is returned;
  total   write plus read: from the submission until a strong read finds it.

It also reports the object-store operations per write (the writer's own and,
for the read, the reader's, through `FYRR_OBJECT_STORE_DIAGNOSTICS`), the
fragment and index-segment counts of the served version (`writer status`)
and, for the largest batch, how much of a write is receiving and binding the
body: the same body, refused with `403` after it was read and scanned, and
with `400 vector_invalid` after every row before the last was bound.

  scripts/bench-write --binary target/release/fyrr --storage local
  eval "$(scripts/s3-fixture env)"; scripts/bench-write --storage fixture
  FYRR_BENCH_S3_URI=s3://bucket/prefix scripts/bench-write --storage s3

The S3 modes use the fixture's or the environment's credentials (`s3` reads
the AWS credential chain; `FYRR_BENCH_S3_REGION` overrides the region). Output
is one JSON document on stdout and a table on stderr.
"""

import argparse
import collections
import contextlib
import http.client
import json
import math
import os
import platform
import random
import secrets
import shutil
import socket
import subprocess
import sys
import tempfile
import time
from pathlib import Path

DIMENSIONS = 128
# (rows per write, writes). The p99 of fewer than 100 writes is their maximum.
PLAN = ((1, 1000), (1000, 50), (50000, 5))
ROOT = Path(__file__).resolve().parent.parent


def free_address():
    with socket.socket() as probe:
        probe.bind(("127.0.0.1", 0))
        return "127.0.0.1:%d" % probe.getsockname()[1]


def percentile(sorted_values, fraction):
    """Nearest rank."""
    return sorted_values[max(0, math.ceil(fraction * len(sorted_values)) - 1)]


def summary(seconds):
    ordered = sorted(seconds)
    return {
        "p50_ms": round(percentile(ordered, 0.50) * 1000, 2),
        "p90_ms": round(percentile(ordered, 0.90) * 1000, 2),
        "p99_ms": round(percentile(ordered, 0.99) * 1000, 2),
        "max_ms": round(ordered[-1] * 1000, 2),
    }


class Rows:
    """Distinct vectors without a random draw per number: 512 random vectors,
    each rotated by a further offset every 512 rows."""

    def __init__(self):
        rng = random.Random(1729)
        self.pool = [[f"{rng.uniform(-1, 1):.4f}" for _ in range(DIMENSIONS)] for _ in range(512)]

    def vector(self, n, short=False):
        base = self.pool[n % 512]
        shift = (n // 512) % DIMENSIONS
        values = base[shift:] + base[:shift]
        return values[:-1] if short else values

    def body(self, prefix, rows, short_last=False):
        encoded = []
        for n in range(rows):
            vector = self.vector(n, short_last and n == rows - 1)
            encoded.append(
                '{"id":"%s-%d","text":"row %s %d","vector":[%s]}'
                % (prefix, n, prefix, n, ",".join(vector))
            )
        return ('{{"upserts":[{}]}}'.format(",".join(encoded))).encode()


class Server:
    def __init__(self, address):
        self.host, port = address.split(":")
        self.port = int(port)

    def call(self, method, path, key, body=None):
        """One request on its own connection. The clock starts when the
        connection is made, so the connection is not in the time."""
        headers = {"Authorization": "Bearer " + key, "Content-Type": "application/json"}
        connection = http.client.HTTPConnection(self.host, self.port, timeout=1800)
        connection.connect()
        started = time.perf_counter()
        try:
            connection.request(method, path, body, headers)
        except (BrokenPipeError, ConnectionResetError):
            pass  # a refusal can answer before the body is sent; the answer is read
        response = connection.getresponse()
        answer = response.read()
        elapsed = time.perf_counter() - started
        connection.close()
        with contextlib.suppress(ValueError):
            answer = json.loads(answer)
        return response.status, answer, elapsed


class Diagnostics:
    """Object-store operations of one process, counted by method."""

    def __init__(self, path):
        self.path = path
        self.seen = 0

    def take(self):
        lines = self.path.read_text().splitlines() if self.path.exists() else []
        fresh = collections.Counter(json.loads(line)["method"] for line in lines[self.seen :])
        self.seen = len(lines)
        return fresh


def storage_config(kind, work):
    if kind == "local":
        return 'uri = "file://%s"\n' % (work / "storage")
    if kind == "fixture":
        env = os.environ
        return (
            'uri = "s3://{}/bench-{}"\nendpoint = "{}"\nallow_http = true\n'
            'access_key_id = {{ env = "FYRR_TEST_S3_ACCESS_KEY_ID" }}\n'
            'secret_access_key = {{ env = "FYRR_TEST_S3_SECRET_ACCESS_KEY" }}\n'.format(
                env["FYRR_TEST_S3_BUCKET"],
                work.name,
                env["FYRR_TEST_S3_ENDPOINT"],
            )
        )
    uri = os.environ["FYRR_BENCH_S3_URI"].rstrip("/")
    region = os.environ.get("FYRR_BENCH_S3_REGION")
    return 'uri = "{}/bench-{}"\n{}'.format(
        uri,
        work.name,
        f'region = "{region}"\n' if region else "",
    )


def machine():
    cpu = next(
        (
            line.split(":", 1)[1].strip()
            for line in Path("/proc/cpuinfo").read_text().splitlines()
            if line.startswith("model name")
        ),
        "unknown",
    )
    memory = next(
        int(line.split()[1]) // 1024
        for line in Path("/proc/meminfo").read_text().splitlines()
        if line.startswith("MemTotal")
    )
    return {
        "kernel": platform.release(),
        "cpu": cpu,
        "logical_cpus": os.cpu_count(),
        "memory_mib": memory,
    }


def main():
    parser = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    parser.add_argument("--binary", default=str(ROOT / "target/release/fyrr"))
    parser.add_argument("--storage", choices=("local", "fixture", "s3"), default="local")
    args = parser.parse_args()
    binary = Path(args.binary).resolve()

    # Local storage refuses a path with a symlink in it, and `target` may be one.
    work = Path(tempfile.mkdtemp(prefix="write-", dir=ROOT / "target")).resolve()
    work.chmod(0o700)
    write_key = "fyrr_key_" + secrets.token_hex(32)
    read_key = "fyrr_key_" + secrets.token_hex(32)
    writer_address, reader_address = free_address(), free_address()
    config = work / "fyrr.toml"
    config.write_text(
        '[namespace]\nname = "bench-1"\n[storage]\n%s'
        '[embedding]\nendpoint = "http://127.0.0.1:9/v1"\nmodel = "caller-supplied"\n'
        "dimensions = %d\n"
        '[identity]\nhashing_key = { env = "FYRR_BENCH_HASHING_KEY" }\n'
        'encryption_key = { env = "FYRR_BENCH_ENCRYPTION_KEY" }\n'
        "[namespace.write_api]\nopen = true\n"
        "[[identity.api_keys]]\nname = 'writer'\nkey = { env = 'FYRR_BENCH_WRITE_KEY' }\n"
        "roles = ['write']\n"
        "[[identity.api_keys]]\nname = 'reader'\nkey = { env = 'FYRR_BENCH_READ_KEY' }\n"
        "readers = ['usr:bench']\n"
        "[writer]\nthreads = 2\n"
        "[writer.serve.admin]\nlisten = '%s'\noperator_token = { env = 'FYRR_BENCH_OPERATOR' }\n"
        "[reader]\nmirror_path = '%s'\nmirror_max_bytes = 1073741824\n"
        "[reader.http]\nlisten = '%s'\npublic_url = 'http://%s/mcp'\n"
        % (
            storage_config(args.storage, work),
            DIMENSIONS,
            writer_address,
            work / "mirror",
            reader_address,
            reader_address,
        )
    )
    env = dict(
        os.environ,
        FYRR_BENCH_HASHING_KEY=secrets.token_hex(32),
        FYRR_BENCH_ENCRYPTION_KEY=secrets.token_hex(32),
        FYRR_BENCH_WRITE_KEY=write_key,
        FYRR_BENCH_READ_KEY=read_key,
        FYRR_BENCH_OPERATOR=secrets.token_hex(16),
        VIRTUAL_ENV=str(ROOT / "connectors/.venv"),
    )
    env.pop("FYRR_OBJECT_STORE_DIAGNOSTICS", None)
    base = [str(binary), "--config", str(config)]

    def run(command, diagnostics=None):
        process_env = dict(env)
        if diagnostics:
            process_env["FYRR_OBJECT_STORE_DIAGNOSTICS"] = str(diagnostics)
        return subprocess.Popen(
            base + command,
            env=process_env,
            stdout=subprocess.DEVNULL,
            stderr=(work / ("-".join(command[:2]) + ".stderr")).open("w"),
        )

    keys = subprocess.run([*base, "writer", "keys"], env=env, capture_output=True, text=True)
    if keys.returncode:
        raise SystemExit("writer keys failed: " + keys.stderr)
    writer_log, reader_log = work / "writer.jsonl", work / "reader.jsonl"
    writer = run(["writer", "serve", "--jobs", "1"], writer_log)
    reader = None
    try:
        write = Server(writer_address)
        rows = Rows()
        path = "/v1/namespaces/%s/documents"
        # The namespaces exist, with one row each, before anything is timed.
        for ns, _ in PLAN:
            ns = "bench-%d" % ns
            for _ in range(600):
                try:
                    status, answer, _t = write.call(
                        "POST", path % ns, write_key, rows.body(ns + "-warm", 1)
                    )
                    break
                except OSError:
                    time.sleep(0.1)
            else:
                raise SystemExit("the writer did not come up")
            assert status == 200, (status, answer)
        reader = run(["reader", "serve"], reader_log)
        read = Server(reader_address)
        for _ in range(600):
            try:
                if read.call("GET", "/readyz", read_key)[0] == 200:
                    break
            except OSError:
                pass
            time.sleep(0.1)

        def fetch(ns, root):
            return read.call(
                "POST",
                f"/v1/namespaces/{ns}/fetch",
                read_key,
                json.dumps(
                    {"source_id": "_api", "root_id": root, "consistency": "strong"}
                ).encode(),
            )

        # One strong read of every namespace opens it, outside the timing.
        for ns, _ in PLAN:
            status, answer, _t = fetch("bench-%d" % ns, "bench-%d-warm-0" % ns)
            assert status == 200 and answer["documents"], (status, answer)

        writer_ops, reader_ops = Diagnostics(writer_log), Diagnostics(reader_log)
        writer_ops.take(), reader_ops.take()
        result = {}
        serve_log = work / "writer-serve.stderr"

        def maintenance_runs():
            return serve_log.read_text().count("event=maintained")

        for batch, count in PLAN:
            maintained = maintenance_runs()
            ns = "bench-%d" % batch
            writes, reads = [], []
            for n in range(count):
                body = rows.body("%s-w%d" % (ns, n), batch)
                status, answer, elapsed = write.call("POST", path % ns, write_key, body)
                assert status == 200 and answer["upserted"] == batch, (status, answer)
                last = "%s-w%d-%d" % (ns, n, batch - 1)
                status, answer, took = fetch(ns, last)
                assert status == 200 and answer["documents"], (status, answer)
                writes.append(elapsed)
                reads.append(took)
            ops = writer_ops.take()
            entry = {
                "writes": count,
                "write": summary(writes),
                "read": summary(reads),
                "total": summary([w + r for w, r in zip(writes, reads, strict=False)]),
                "maintenance_runs": maintenance_runs() - maintained,
                "writes_over_10s": sum(1 for w in writes if w > 10),
                "writer_object_store_ops_per_write": {
                    m: round(c / count, 2) for m, c in sorted(ops.items())
                },
                "reader_object_store_ops_per_read": {
                    m: round(c / count, 2) for m, c in sorted(reader_ops.take().items())
                },
            }
            if batch == PLAN[0][0]:
                status = subprocess.run(
                    [*base, "writer", "status"],
                    env=env,
                    check=True,
                    capture_output=True,
                )
                shape = json.loads(status.stdout)
                entry["after"] = {
                    "fragments": shape["fragments"],
                    "index_segments": shape["index_segments"],
                }
            result[str(batch)] = entry
            print("batch %d done" % batch, file=sys.stderr, flush=True)

        # Receiving and binding the body, on the largest batch: the same rows,
        # refused after they were read and scanned, and after they were bound.
        big = PLAN[-1][0]
        ns = "bench-%d" % big
        text = rows.body(ns + "-probe", big)
        conditions = b',"conditions":{"x":{"field":"x","op":"eq","value":1}}}'
        refused_scan, refused_bind = [], []
        for _ in range(3):
            status, _a, took = write.call("POST", path % ns, write_key, text[:-1] + conditions)
            assert status == 403, status
            refused_scan.append(took)
            status, _a, took = write.call(
                "POST", path % ns, write_key, rows.body(ns + "-probe", big, True)
            )
            assert status == 400, status
            refused_bind.append(took)
        result[str(big)]["receive"] = {
            "refused_after_scan_p50_ms": summary(refused_scan)["p50_ms"],
            "refused_after_bind_p50_ms": summary(refused_bind)["p50_ms"],
            "samples": len(refused_scan),
        }
    finally:
        for process in (reader, writer):
            if process:
                process.terminate()
                process.wait(timeout=60)

    version = subprocess.run(
        [str(binary), "--version"], capture_output=True, text=True, check=True
    ).stdout.strip()
    commit = subprocess.run(
        ["git", "-C", str(ROOT), "rev-parse", "--short", "HEAD"],
        capture_output=True,
        text=True,
    ).stdout.strip()
    report = {
        "storage": args.storage,
        "dimensions": DIMENSIONS,
        "version": version,
        "commit": commit,
        "machine": machine(),
        "batches": result,
    }
    print(json.dumps(report, indent=2))
    print(
        "%-8s %-6s %-26s %-26s %-26s"
        % ("rows", "writes", "write p50/p90/p99 ms", "read p50/p90/p99 ms", "total p50/p90/p99 ms"),
        file=sys.stderr,
    )
    for batch, entry in result.items():
        cells = [
            "{:g}/{:g}/{:g}".format(entry[k]["p50_ms"], entry[k]["p90_ms"], entry[k]["p99_ms"])
            for k in ("write", "read", "total")
        ]
        print("%-8s %-6d %-26s %-26s %-26s" % (batch, entry["writes"], *cells), file=sys.stderr)
    shutil.rmtree(work)


if __name__ == "__main__":
    main()
