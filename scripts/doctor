#!/usr/bin/env bash
# Verifies the prerequisites for building and testing fyrr and prepares the
# pinned local tools (protoc into target/tools, the uv-managed Python and the
# locked connectors venv that PyO3 links against, the RustFS image).
# Idempotent; run it before the first work in a worktree.
source "$(dirname "${BASH_SOURCE[0]}")/lib.sh"
cd "$ROOT"

LOCAL=0
case "${1:-}" in
  "") ;;
  --local) LOCAL=1 ;;
  *) die "usage: scripts/doctor [--local]" ;;
esac
(($# <= 1)) || die "usage: scripts/doctor [--local]"

failures=0
ok() { printf 'ok    %s\n' "$*"; }
bad() { printf 'FAIL  %s\n' "$*"; failures=$((failures + 1)); }
warn() { printf 'warn  %s\n' "$*"; }

for tool in git curl unzip sha256sum openssl python3 rustup uv cc jq; do
  if command -v "$tool" >/dev/null; then ok "$tool: $(command -v "$tool")"; else bad "$tool is not installed"; fi
done

channel="$(sed -n 's/^channel = "\(.*\)"/\1/p' rust-toolchain.toml)"
if rustc_version="$(rustc --version 2>/dev/null)" && [[ "$rustc_version" == "rustc $channel "* ]]; then
  ok "Rust toolchain $channel (rust-toolchain.toml): $rustc_version"
else
  bad "Rust $channel is not active; run: rustup toolchain install $channel --component rustfmt,clippy"
fi
for component in rustfmt clippy; do
  if rustup component list --installed --toolchain "$channel" 2>/dev/null | grep -q "^$component"; then
    ok "Rust component $component"
  else
    bad "Rust component $component missing; run: rustup component add $component --toolchain $channel"
  fi
done

if [[ "$(mbx --version 2>/dev/null)" == "mbx 1.30.0" ]]; then
  ok "mr-boxington 1.30.0 (mise.toml)"
else
  if ((LOCAL)); then warn "mr-boxington 1.30.0 missing (required for CI)"; else bad "mr-boxington 1.30.0 missing; run: mise install"; fi
fi

if deny_version="$(cargo deny --version 2>/dev/null)" && [[ "$deny_version" == "cargo-deny $CARGO_DENY_VERSION" ]]; then
  ok "$deny_version"
else
  if ((LOCAL)); then warn "cargo-deny $CARGO_DENY_VERSION missing (required for CI)"; else bad "cargo-deny $CARGO_DENY_VERSION missing; run: cargo install --locked cargo-deny@$CARGO_DENY_VERSION"; fi
fi

if ensure_protoc; then ok "protoc $PROTOC_VERSION (pinned, checksum verified): $PROTOC_DIR/bin/protoc"; else bad "protoc could not be prepared"; fi

python_version="$(cat connectors/.python-version)"
if uv python find "$python_version" >/dev/null 2>&1 || uv python install "$python_version" >/dev/null 2>&1; then
  ok "Python $python_version (uv-managed, connectors/.python-version)"
else
  bad "uv cannot provide Python $python_version"
fi
# The full build's PyO3 links this venv's interpreter (.cargo/config.toml
# PYO3_PYTHON); the CLI tests run providers in it (VIRTUAL_ENV).
if (cd connectors && uv sync --locked --quiet); then
  ok "connectors venv (uv.lock): connectors/.venv"
else
  bad "cannot create connectors/.venv; run: cd connectors && uv sync --locked"
fi
for tool in readelf; do
  if command -v "$tool" >/dev/null; then ok "$tool: $(command -v "$tool")"; else bad "$tool is not installed (binutils)"; fi
done
if ((!LOCAL)); then
  if command -v docker >/dev/null; then ok "docker: $(command -v docker)"; else bad "docker is not installed"; fi
  if docker compose version >/dev/null 2>&1; then ok "docker compose (scripts/images)"; else warn "docker compose missing; scripts/images needs it"; fi

  if docker info >/dev/null 2>&1; then
    ok "docker daemon reachable"
    if docker image inspect "$RUSTFS_IMAGE" >/dev/null 2>&1 || docker pull -q "$RUSTFS_IMAGE" >/dev/null; then
      ok "RustFS image ${RUSTFS_IMAGE#*@}"
    else
      bad "cannot pull $RUSTFS_IMAGE"
    fi
  else
    bad "docker daemon not reachable (the real-S3 fixture needs it)"
  fi
fi

free_gib=$(($(df --output=avail -k "$ROOT" | tail -n 1) / 1024 / 1024))
if ((free_gib < 10)); then
  bad "only ${free_gib} GiB free on the build volume; scripts/ci needs about 10 GiB of target space"
elif ((free_gib < 20)); then
  warn "${free_gib} GiB free on the build volume"
else
  ok "${free_gib} GiB free on the build volume"
fi

if ((failures > 0)); then
  echo "doctor: $failures problem(s)"
  exit 1
fi
echo "doctor: OK"
