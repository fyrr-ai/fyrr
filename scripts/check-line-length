#!/usr/bin/env python3
"""Reject Rust source lines over 100 characters in selected paths.

With no paths, checks every crate's src. CI enforces the reader and core
layout paths; the rest can be checked explicitly during formatting work.
"""

import sys
from pathlib import Path

repository = Path(__file__).resolve().parent.parent
roots = [Path(arg) for arg in sys.argv[1:]] or sorted(repository.glob("crates/*/src"))
failed = False
for root in roots:
    files = [root] if root.is_file() else sorted(root.rglob("*.rs"))
    if not files:
        print(f"{root}: no Rust source files selected")
        failed = True
    for path in files:
        for number, line in enumerate(path.read_text().splitlines(), 1):
            if len(line) > 100:
                print(f"{path}:{number}: {len(line)} characters exceeds 100")
                failed = True
sys.exit(int(failed))
