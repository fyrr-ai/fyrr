#!/usr/bin/env bash
# The same complete test suite locally and on GitHub. Compile each variant
# once, execute exact owned cases, and run bounded real-S3 rows on isolated
# fixtures. Keep going after failures; unselected/release-only checks are n/e.
# Logs and per-step counts live under target/ci-logs/<stamp>/summary.txt.
#
# scripts/ci [--jobs=N] [--step=NAME ...]
source "$(dirname "${BASH_SOURCE[0]}")/lib.sh"
cd "$ROOT"

ONLY_STEPS=0
JOBS="${FYRR_CI_JOBS:-$(python3 - <<'JOBS'
import os
from pathlib import Path
memory = dict((line.split(':')[0], int(line.split()[1]))
              for line in Path('/proc/meminfo').read_text().splitlines())
# Reserve 2 GiB for the host, allow up to 8 GiB of the configured swap, and
# budget 4 GiB per fixture/row. Cargo builds finish before any rows start.
capacity = memory['MemAvailable'] + min(memory['SwapFree'], 8 * 1024**2)
print(max(1, min(6, len(os.sched_getaffinity(0)), (capacity - 2 * 1024**2) // (4 * 1024**2))))
JOBS
)}"
S3_ROW=
declare -A REQUESTED_STEPS=() SEEN_STEPS=()
for arg in "$@"; do
  case "$arg" in
    --jobs=*) JOBS="${arg#--jobs=}" ;;
    --s3-row=*)
      S3_ROW="${arg#--s3-row=}"
      ONLY_STEPS=1
      REQUESTED_STEPS["real S3: ${S3_ROW#s3-}"]=1
      JOBS=1
      ;;
    --step=*)
      name="${arg#--step=}"
      [[ -n "$name" ]] || die "--step requires an exact step name"
      ONLY_STEPS=1
      REQUESTED_STEPS["$name"]=1
      ;;
    *) die "unknown argument $arg (use --jobs=N or --step=NAME)" ;;
  esac
done
[[ "$JOBS" =~ ^[1-9][0-9]*$ ]] || die "--jobs must be a positive integer"
# Harness cases that inspect process-wide descriptors need serial execution.
# Independent real-S3 rows run concurrently on separate fixtures below.
export RUST_TEST_THREADS="${RUST_TEST_THREADS:-1}"
# The drift test rewrites goldens when this is set; CI must only compare.
unset FYRR_UPDATE_GOLDEN

STAMP="$(date -u +%Y%m%dT%H%M%SZ)-$$"
LOGS="${FYRR_CI_LOG_DIR:-$ROOT/target/ci-logs/$STAMP}"
mkdir -p "$LOGS" "$ROOT/target/tmp"
exec > >(tee "$LOGS/ci.log") 2>&1

declare -a ROWS
STEP=0
FAILED=0

# step <name> <counts: cargo|pytest|none> <command...>
step() {
  local name="$1" kind="$2"
  shift 2
  SEEN_STEPS["$name"]=1
  if ((ONLY_STEPS)) && [[ ! ${REQUESTED_STEPS["$name"]+selected} ]]; then
    not_evaluated "$name" "not selected by --step"
    return
  fi
  STEP=$((STEP + 1))
  local log
  log="$LOGS/$(printf '%02d' "$STEP")-$(tr -c 'a-z0-9\n' '-' <<<"${name,,}" | tr -s '-' | sed 's/^-//; s/-$//').log"
  log "step $STEP: $name"
  local started=$SECONDS status=pass passed=- failed=- ignored=-
  "$@" >"$log" 2>&1 || status=FAIL
  case "$kind" in
    cargo)
      read -r passed failed ignored < <(
        sed -nE 's/^test result: [A-Za-z]+\. ([0-9]+) passed; ([0-9]+) failed; ([0-9]+) ignored;.*/\1 \2 \3/p' "$log" |
          awk '{p += $1; f += $2; i += $3} END {print p + 0, f + 0, i + 0}'
      )
      ;;
    pytest)
      read -r passed failed ignored < <(
        awk '/^=+ .* =+$/ {
          for (i = 2; i <= NF; i++) {
            if ($i ~ /^passed,?$/) p += $(i - 1)
            if ($i ~ /^failed,?$/) f += $(i - 1)
            if ($i ~ /^skipped,?$/) s += $(i - 1)
          }
        } END {print p + 0, f + 0, s + 0}' "$log"
      )
      ;;
  esac
  if [[ "$kind" != none && "$status" == pass && "$passed" == 0 ]]; then
    status="FAIL"
    echo "zero tests selected" >>"$log"
  fi
  [[ "$status" == pass ]] || FAILED=$((FAILED + 1))
  ROWS+=("$(printf '%-38s %-5s %7s %7s %8s %6ss  %s' "$name" "$status" "$passed" "$failed" "$ignored" "$((SECONDS - started))" "${log#"$ROOT"/}")")
  if [[ "$status" != pass ]]; then
    log "step $STEP FAILED: $name (log: ${log#"$ROOT"/})"
    tail -n 30 "$log"
  fi
}

ensure_build() {
  if [[ "${FYRR_CI_PREBUILT:-}" != 1 ]]; then
    "$ROOT/scripts/ci-cases" build || return 1
    export FYRR_CI_PREBUILT=1
  fi
}
run_cases() { ensure_build && "$ROOT/scripts/ci-cases" run "$1"; }
case_step() { step "$1" cargo run_cases "$2"; }
ownership_check() { ensure_build && "$ROOT/scripts/ci-cases" check; }
reference_docs() {
  ensure_build && "$ROOT/scripts/check-docs" \
    "$ROOT/target/ci-build/full/fyrr" "$ROOT/target/ci-build/reader/fyrr"
}
quickstart() {
  ensure_build && "$ROOT/scripts/ci-cases" binary full >/dev/null &&
    FYRR_CI_PREBUILT=1 "$ROOT/examples/quickstart/run" "$@"
}
reader_link_check() { ensure_build && "$ROOT/scripts/check-reader-only"; }

FIXTURE_STARTED=0
KEYCLOAK_STARTED=0
cleanup_fixture() {
  if ((KEYCLOAK_STARTED)); then
    "$ROOT/scripts/keycloak-fixture" stop || true
  fi
  if ((FIXTURE_STARTED)); then
    "$ROOT/scripts/s3-fixture" stop || true
  fi
}
trap cleanup_fixture EXIT

# Functions run by `step` sit in a `||` context where `set -e` is off, so
# every command is chained explicitly.
real_s3_setup() {
  ensure_build || return 1
  if ! "$ROOT/scripts/s3-fixture" status | grep -q ' running '; then
    FIXTURE_STARTED=1
    "$ROOT/scripts/s3-fixture" start || {
      "$ROOT/scripts/s3-fixture" stop && "$ROOT/scripts/s3-fixture" start
    } || return 1
  fi
  if [[ "${FYRR_CI_NEEDS_KEYCLOAK:-1}" == 1 ]] && ! "$ROOT/scripts/keycloak-fixture" status >/dev/null 2>&1; then
    KEYCLOAK_STARTED=1
    "$ROOT/scripts/keycloak-fixture" start || {
      "$ROOT/scripts/keycloak-fixture" stop && "$ROOT/scripts/keycloak-fixture" start
    } || return 1
  fi
  local exports
  FYRR_SCIM_HEALTH_TEST_BINARY="$("$ROOT/scripts/ci-cases" binary full:fyrr-writer:lib:fyrr_writer)" || return 1
  FYRR_ROUTING_TEST_BINARY="$("$ROOT/scripts/ci-cases" binary full:fyrr-reader:lib:fyrr_reader)" || return 1
  exports="$("$ROOT/scripts/s3-fixture" env)" && eval "$exports" || return 1
  if [[ "${FYRR_CI_NEEDS_KEYCLOAK:-1}" == 1 ]]; then
    exports="$("$ROOT/scripts/keycloak-fixture" env)" && eval "$exports" || return 1
  fi

}

real_s3_selection() {
  local ready="$1"
  shift
  if (( !ready )); then
    echo "real-S3 fixture setup failed; see ci.log"
    return 1
  fi
  "$@"
}

real_s3() {
  local -x RUST_TEST_THREADS=1 FYRR_SCIM_HEALTH_TEST_BINARY FYRR_ROUTING_TEST_BINARY
  local -a selected_rows=()
  local row name line
  while IFS= read -r row; do
    name="real S3: ${row#s3-}"
    if ((!ONLY_STEPS)) || [[ ${REQUESTED_STEPS["$name"]+selected} ]]; then
      selected_rows+=("$row")
    else
      not_evaluated "$name" "not selected by --step"
    fi
  done < <("$ROOT/scripts/ci-cases" rows s3)
  ((${#selected_rows[@]})) || return 0
  if [[ -n "$S3_ROW" ]]; then
    local ready=1
    local -x FYRR_CI_NEEDS_KEYCLOAK=0
    [[ "$S3_ROW" != s3-identity ]] || FYRR_CI_NEEDS_KEYCLOAK=1
    real_s3_setup || ready=0
    step "real S3: ${S3_ROW#s3-}" cargo real_s3_selection "$ready" "$ROOT/scripts/ci-cases" run "$S3_ROW"
    return
  fi
  if ! ensure_build; then
    for row in "${selected_rows[@]}"; do
      step "real S3: ${row#s3-}" cargo real_s3_selection 0 false
    done
    return
  fi
  "$ROOT/scripts/ci-cases" binary full >/dev/null || return 1
  log "running ${#selected_rows[@]} real-S3 rows with up to $JOBS independent fixtures"
  # Every worker has an immutable full build, private fixture names/data and
  # logs. xargs waits for all workers even when one returns a failure.
  printf '%s\0' "${selected_rows[@]}" >"$LOGS/s3-rows.txt"
  if ! xargs -0 -r -P "$JOBS" -I{} bash -c '
    row="$1"; directory="$2/$row"
    mkdir -p "$directory"
    FYRR_CI_LOG_DIR="$directory" FYRR_FIXTURE_ID="ci-$3-$row" FYRR_CI_PREBUILT=1 \
      "$4/scripts/ci" "--s3-row=$row" >"$directory/runner.log" 2>&1
  ' _ {} "$LOGS" "$$" "$ROOT" <"$LOGS/s3-rows.txt"; then
    FAILED=$((FAILED + 1))
  fi
  for row in "${selected_rows[@]}"; do
    STEP=$((STEP + 1))
    SEEN_STEPS["real S3: ${row#s3-}"]=1
    line="$(grep -E '^real S3: .* (pass|FAIL) ' "$LOGS/$row/summary.txt" 2>/dev/null)" || line=
    if [[ -z "$line" ]]; then
      FAILED=$((FAILED + 1))
      ROWS+=("$(printf '%-38s %-5s %7s %7s %8s %6ss  %s' "real S3: ${row#s3-}" FAIL 0 0 0 0 "missing worker summary: ${LOGS#"$ROOT"/}/$row/runner.log")")
    else
      ROWS+=("$line")
    fi
  done
}

# The real-executable rows on `file://` storage need no fixture, only the
# fixed development secrets their configurations reference.
local_storage() {
  ensure_build || return 1
  local -x RUST_TEST_THREADS=1 FYRR_ROUTING_TEST_BINARY FYRR_TEST_LOCAL_SECRET=fyrr-local-test-secret
  local -x FYRR_TEST_ENCRYPTION_KEY
  FYRR_TEST_ENCRYPTION_KEY="$(printf fyrr-local-test | sha256sum | cut -c1-64)" || return 1
  FYRR_ROUTING_TEST_BINARY="$("$ROOT/scripts/ci-cases" binary full:fyrr-reader:lib:fyrr_reader)" || return 1
  "$ROOT/scripts/ci-cases" run local-storage
}

python_checks() {
  (cd "$ROOT/connectors" &&
    unset PYTHONPATH &&
    uv sync --locked --all-extras &&
    uv run --locked --all-extras ruff check . ../crates/fyrr/tests/providers ../scripts/ci-cases ../scripts/check-docs &&
    uv run --locked --all-extras ruff format --check . ../crates/fyrr/tests/providers ../scripts/ci-cases ../scripts/check-docs &&
    "$ROOT/scripts/ci-cases" run python-sdk)
}

# The example provider's own tests, with the SDK's provider test kit.
example_provider() {
  (cd "$ROOT/examples/markdown-provider" &&
    uv sync --locked &&
    uv run --locked ruff check &&
    uv run --locked ruff format --check &&
    "$ROOT/scripts/ci-cases" run python-example)
}

# The example wheel, built outside the workspace, installed into its own
# directory and used by the already-built full binary: provider listed and
# the Markdown source synced (dry run).
example_wheels() {
  local wheels="$ROOT/target/example-wheels" site="$ROOT/target/example-site" config output
  rm -rf "$wheels" "$site"
  uv build --wheel --quiet --out-dir "$wheels" "$ROOT/examples/markdown-provider" || return 1
  uv pip install --quiet --no-deps --python "$ROOT/connectors/.venv/bin/python" \
    --target "$site" "$wheels"/*.whl || return 1
  ensure_build && "$ROOT/scripts/ci-cases" binary full >/dev/null || return 1
  config="$site/fyrr.toml"
  printf '%s\n' '[namespace]' 'name = "dev"' '[storage]' 'uri = "s3://fyrr-dev/dev"' \
    '[identity]' 'hashing_key = { env = "FYRR_EXAMPLE_HASHING_KEY" }' \
    '[embedding]' 'endpoint = "https://embeddings.invalid/v1"' '[[sources]]' 'id = "handbook"' \
    'type = "markdown-dir"' 'permissions = "fixed"' 'readers = ["grp:engineering"]' \
    '[sources.scope]' "root = \"$ROOT/examples/markdown-provider/tests/data\"" >"$config"
  run_fyrr() {
    VIRTUAL_ENV="$ROOT/connectors/.venv" PYTHONPATH="$site" PYTHONDONTWRITEBYTECODE=1 \
      FYRR_EXAMPLE_HASHING_KEY=example-wheels-key \
      "$ROOT/target/debug/fyrr" "$@"
  }
  output="$(run_fyrr writer providers)"
  echo "$output"
  grep -qE '^markdown-dir +fyrr-provider-markdown +0\.1\.0 .* ok$' <<<"$output" &&
    output="$(run_fyrr --config "$config" writer sync --dry-run)" &&
    printf '%s\n' "$output" &&
    grep -q 'upserts=2' <<<"$output" &&
    grep -q 'dry run: 1 source(s) passed, 0 failed' <<<"$output"
}

# A check this run did not perform: listed as n/e (not evaluated), never as
# passed.
not_evaluated() {
  SEEN_STEPS["$1"]=1
  STEP=$((STEP + 1))
  ROWS+=("$(printf '%-38s %-5s %7s %7s %8s %6ss  %s' "$1" "n/e" - - - 0 "$2")")
  log "step $STEP: $1 not evaluated ($2)"
}

log "fyrr ci: logs in ${LOGS#"$ROOT"/}"
step "doctor" none "$ROOT/scripts/doctor"
step "rustfmt" none cargo fmt --all --check
step "Rust source line length (reader)" none "$ROOT/scripts/check-line-length" \
  "$ROOT/crates/fyrr-reader/src" "$ROOT/crates/fyrr-core/src/layout.rs" \
  "$ROOT/crates/fyrr-core/src/layout"
step "clippy (full workspace)" none cargo clippy --locked --workspace --all-targets -- -D warnings
step "clippy (reader-only build)" none cargo clippy --locked -p fyrr -p fyrr-reader --no-default-features --all-targets -- -D warnings
step "test-case ownership guard" none ownership_check
case_step "unit tests" units
case_step "native Lance pin checks" lance-pin
case_step "contract fixtures" contracts
case_step "configuration" config
case_step "schema drift" generated
case_step "tools/list golden" mcp
case_step "cli (full build)" cli-full
case_step "cli (reader-only build)" cli-reader
case_step "privacy sentinel (full build)" privacy-full
case_step "privacy sentinel (reader-only build)" privacy-reader
step "reference docs" none reference_docs
case_step "fyrr-eval (internal tool)" eval
step "reader-only link check" none reader_link_check
not_evaluated "release feature isolation" "scripts/release checks release artifacts"
step "licenses and advisories" none cargo deny --locked check
step "python connector SDK" pytest python_checks
step "example provider (test kit)" pytest example_provider
step "example wheels without rebuild" none example_wheels
not_evaluated "budgets" "release size checks run in scripts/release"
not_evaluated "images (build, derived, compose)" "image checks run in scripts/release"
# Before real_s3: the quickstart starts and stops its own fixture.
step "quickstart example (local storage)" none quickstart
step "quickstart example (S3)" none quickstart --s3
step "local storage" cargo local_storage
real_s3

for name in "${!REQUESTED_STEPS[@]}"; do
  if [[ ! ${SEEN_STEPS["$name"]+known} ]]; then
    log "unknown CI step: $name"
    FAILED=$((FAILED + 1))
  fi
done

{
  echo "fyrr ci $STAMP  commit ${FYRR_CI_REVISION:-$(git rev-parse --short HEAD 2>/dev/null || echo unavailable)}  $(rustc --version)"
  printf '%-38s %-5s %7s %7s %8s %7s  %s\n' step status passed failed ignored time log
  printf '%s\n' "${ROWS[@]}"
  echo "steps: $STEP, failed: $FAILED"
} | tee "$LOGS/summary.txt"

if ((FAILED > 0)); then
  log "ci FAILED ($FAILED step(s)); full logs in ${LOGS#"$ROOT"/}"
  exit 1
fi
log "ci passed; full logs in ${LOGS#"$ROOT"/}"
