#!/usr/bin/env bash
# One local/hosted entry point for quick, full and image tiers. Compile each variant
# once, execute exact owned cases, and run bounded Rust cases on isolated
# fixtures. Keep going after failures; unselected/release-only checks are n/e.
# Logs and per-step counts live under target/ci-logs/<stamp>/summary.txt.
#
# scripts/ci [--quick|--images] [--debug-only] [--jobs=N] [--step=NAME ...]
source "$(dirname "${BASH_SOURCE[0]}")/lib.sh"
cd "$ROOT"

declare -A ROW_TITLES=()
while IFS=$'\t' read -r row title; do ROW_TITLES["$row"]="$title"; done < <("$ROOT/scripts/ci-cases" titles)
row_name() { printf '%s\n' "${ROW_TITLES[$1]:-$1}"; }

ONLY_STEPS=0
TIER="${FYRR_CI_TIER:-full}"
IMAGES=0
DEBUG_ONLY=0
JOBS="${FYRR_CI_JOBS:-$(python3 - <<'JOBS'
import os
from pathlib import Path
memory = dict((line.split(':')[0], int(line.split()[1]))
              for line in Path('/proc/meminfo').read_text().splitlines())
# Reserve 4 GiB for core gates and Docker fixtures. Representative case process trees
# peaked below 0.5 GiB; allow 2 GiB per worker for larger cases and shared-page
# overcounting. Do not treat swap as available working memory.
capacity = memory['MemAvailable']
limit = Path('/sys/fs/cgroup/memory.max')
usage = Path('/sys/fs/cgroup/memory.current')
if limit.exists() and limit.read_text().strip().isdigit():
    available = max(0, int(limit.read_text()) - int(usage.read_text())) // 1024
    capacity = min(capacity, available)
print(max(1, min(len(os.sched_getaffinity(0)), (capacity - 4 * 1024**2) // (2 * 1024**2))))
JOBS
)}"
CASE_ROW=
CASE_ID=
POOL_PID=0
declare -a POOL_ROWS=()
declare -A REQUESTED_STEPS=() SEEN_STEPS=()
for arg in "$@"; do
  case "$arg" in
    --quick) TIER=quick ;;
    --images) IMAGES=1 ;;
    --debug-only) DEBUG_ONLY=1 ;;
    --jobs=*) JOBS="${arg#--jobs=}" ;;
    --row=*)
      CASE_ROW="${arg#--row=}"
      ONLY_STEPS=1
      REQUESTED_STEPS["$(row_name "$CASE_ROW")"]=1
      JOBS=1
      ;;
    --case=*) CASE_ID="${arg#--case=}" ;;
    --step=*)
      name="${arg#--step=}"
      [[ -n "$name" ]] || die "--step requires an exact step name"
      ONLY_STEPS=1
      REQUESTED_STEPS["$name"]=1
      ;;
    *) die "unknown argument $arg (use --quick, --images, --jobs=N or --step=NAME)" ;;
  esac
done
[[ "$TIER" == quick || "$TIER" == full ]] || die "unknown CI tier $TIER"
((IMAGES == 0)) || [[ "$TIER" == full ]] || die "--images cannot be combined with --quick"
export FYRR_CI_TIER="$TIER"
[[ -z "$CASE_ID" || -n "$CASE_ROW" ]] || die "--case requires --row"
[[ "$JOBS" =~ ^[1-9][0-9]*$ ]] || die "--jobs must be a positive integer"
if ((JOBS > 1)) && [[ -n "${FYRR_S3_FIXTURE_DATA:-}" ]]; then
  die "parallel CI rows require private fixture data; unset FYRR_S3_FIXTURE_DATA or use --jobs=1"
fi
# Harness cases that inspect process-wide descriptors need serial execution.
# Independent Rust cases run concurrently on private storage below.
export RUST_TEST_THREADS="${RUST_TEST_THREADS:-1}"
# The drift test rewrites goldens when this is set; CI must only compare.
unset FYRR_UPDATE_GOLDEN

STAMP="$(date -u +%Y%m%dT%H%M%SZ)-$$"
LOGS="${FYRR_CI_LOG_DIR:-$ROOT/target/ci-logs/$STAMP}"
mkdir -p "$LOGS" "$ROOT/target/tmp"
exec > >(tee "$LOGS/ci.log") 2>&1

declare -a ROWS
STEP=0
FAILED=0
BUILD_ATTEMPTED=0

# step <name> <counts: cargo|pytest|none> <command...>
step() {
  local name="$1" kind="$2"
  shift 2
  SEEN_STEPS["$name"]=1
  if ((ONLY_STEPS)) && [[ ! ${REQUESTED_STEPS["$name"]+selected} ]]; then
    not_evaluated "$name" "not selected by --step"
    return
  fi
  STEP=$((STEP + 1))
  local log
  log="$LOGS/$(printf '%02d' "$STEP")-$(tr -c 'a-z0-9\n' '-' <<<"${name,,}" | tr -s '-' | sed 's/^-//; s/-$//').log"
  log "step $STEP: $name"
  local started=$SECONDS status=pass passed=- failed=- ignored=-
  "$@" >"$log" 2>&1 || status=FAIL
  case "$kind" in
    cargo)
      read -r passed failed ignored < <(
        sed -nE 's/^test result: [A-Za-z]+\. ([0-9]+) passed; ([0-9]+) failed; ([0-9]+) ignored;.*/\1 \2 \3/p' "$log" |
          awk '{p += $1; f += $2; i += $3} END {print p + 0, f + 0, i + 0}'
      )
      ;;
    pytest)
      read -r passed failed ignored < <(
        awk '/^=+ .* =+$/ {
          for (i = 2; i <= NF; i++) {
            if ($i ~ /^passed,?$/) p += $(i - 1)
            if ($i ~ /^failed,?$/) f += $(i - 1)
            if ($i ~ /^skipped,?$/) s += $(i - 1)
          }
        } END {print p + 0, f + 0, s + 0}' "$log"
      )
      ;;
  esac
  if [[ "$kind" != none && "$status" == pass && "$passed" == 0 ]]; then
    status="FAIL"
    echo "zero tests selected" >>"$log"
  fi
  [[ "$status" == pass ]] || FAILED=$((FAILED + 1))
  ROWS+=("$(printf '%-38s %-5s %7s %7s %8s %6ss  %s' "$name" "$status" "$passed" "$failed" "$ignored" "$((SECONDS - started))" "${log#"$ROOT"/}")")
  if [[ "$status" != pass ]]; then
    log "step $STEP FAILED: $name (log: ${log#"$ROOT"/})"
    tail -n 30 "$log"
  fi
}

ensure_build() {
  if [[ "${FYRR_CI_PREBUILT:-}" != 1 ]]; then
    ((BUILD_ATTEMPTED == 0)) || return 1
    BUILD_ATTEMPTED=1
    "$ROOT/scripts/ci-cases" build || return 1
    export FYRR_CI_PREBUILT=1
  fi
}
ownership_check() { ensure_build && "$ROOT/scripts/ci-cases" check; }
reference_docs() {
  ensure_build && "$ROOT/scripts/check-docs" \
    "$ROOT/target/ci-build/full/fyrr" "$ROOT/target/ci-build/reader/fyrr"
}
quickstart() {
  ensure_build && FYRR_CI_PREBUILT=1 FYRR_CI_BINARY_DIR="$ROOT/target/ci-build/full"     "$ROOT/examples/quickstart/run" "$@"
}
reader_link_check() { ensure_build && "$ROOT/scripts/check-reader-only"; }

FIXTURE_STARTED=0
KEYCLOAK_STARTED=0
cleanup_fixture() {
  if ((POOL_PID)); then
    kill -TERM "$POOL_PID" 2>/dev/null || true
    wait "$POOL_PID" 2>/dev/null || true
  fi
  if ((KEYCLOAK_STARTED)); then
    "$ROOT/scripts/keycloak-fixture" stop || true
  fi
  if ((FIXTURE_STARTED)); then
    "$ROOT/scripts/s3-fixture" stop || true
  fi
}
trap cleanup_fixture EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

# Functions run by `step` sit in a `||` context where `set -e` is off, so
# every command is chained explicitly.
scenario_setup() {
  local row="$1" settings backend exports
  settings="$("$ROOT/scripts/ci-cases" settings "$row")" || return 1
  backend="$(jq -r ' .backend // empty' <<<"$settings")" || return 1
  [[ -n "$backend" ]] || return 0
  export FYRR_TEST_BACKEND="$backend"
  if [[ "$backend" == s3 ]]; then
    if ! "$ROOT/scripts/s3-fixture" status | grep -q ' running '; then
      FIXTURE_STARTED=1
      "$ROOT/scripts/s3-fixture" start || return 1
    fi
    exports="$("$ROOT/scripts/s3-fixture" env)" && eval "$exports" || return 1
    export FYRR_TEST_SECRET="$FYRR_TEST_S3_SECRET_ACCESS_KEY"
  else
    unset FYRR_TEST_S3_BUCKET FYRR_TEST_S3_ACCESS_KEY_ID FYRR_TEST_S3_SECRET_ACCESS_KEY
    export FYRR_TEST_LOCAL_SECRET=fyrr-local-test-secret
    export FYRR_TEST_SECRET="$FYRR_TEST_LOCAL_SECRET"
    # Existing request-boundary fixtures select a local operation controller.
    export FYRR_TEST_S3_ENDPOINT=local-storage
    export FYRR_TEST_ENCRYPTION_KEY
    FYRR_TEST_ENCRYPTION_KEY="$(printf fyrr-local-test | sha256sum | cut -c1-64)" || return 1
  fi
  if jq -e '.services | index("keycloak") != null' <<<"$settings" >/dev/null; then
    if ! "$ROOT/scripts/keycloak-fixture" status >/dev/null 2>&1; then
      KEYCLOAK_STARTED=1
      "$ROOT/scripts/keycloak-fixture" start || return 1
    fi
    exports="$("$ROOT/scripts/keycloak-fixture" env)" && eval "$exports" || return 1
  fi
}

run_row() {
  scenario_setup "$1" || return 1
  local -a selection=()
  [[ -z "$CASE_ID" ]] || selection+=("$CASE_ID")
  "$ROOT/scripts/ci-cases" run "$1" "${selection[@]}"
}

cases_start() {
  local -x FYRR_SCIM_HEALTH_TEST_BINARY FYRR_ROUTING_TEST_BINARY
  local -a selected_rows=()
  local row name count
  if [[ -n "$CASE_ROW" ]]; then
    selected_rows=("$CASE_ROW")
  else
    while IFS=$'\t' read -r row count; do
      name="$(row_name "$row")"
      if ((count == 0)); then
        not_evaluated "$name" "not selected by $TIER tier"
      elif ((!ONLY_STEPS)) || [[ ${REQUESTED_STEPS["$name"]+selected} ]]; then
        selected_rows+=("$row")
      else
        not_evaluated "$name" "not selected by --step"
      fi
    done < <("$ROOT/scripts/ci-cases" rows pool)
  fi
  ((${#selected_rows[@]})) || return 0
  if ! ensure_build; then
    for row in "${selected_rows[@]}"; do
      step "$(row_name "$row")" cargo false
    done
    return
  fi
  FYRR_SCIM_HEALTH_TEST_BINARY="${FYRR_SCIM_HEALTH_TEST_BINARY:-$("$ROOT/scripts/ci-cases" binary full:fyrr-writer:lib:fyrr_writer)}" || return 1
  FYRR_ROUTING_TEST_BINARY="${FYRR_ROUTING_TEST_BINARY:-$("$ROOT/scripts/ci-cases" binary full:fyrr-reader:lib:fyrr_reader)}" || return 1
  if [[ -n "$CASE_ROW" ]]; then
    step "$(row_name "$CASE_ROW")" cargo run_row "$CASE_ROW"
    return
  fi
  POOL_ROWS=("${selected_rows[@]}")
  log "scheduling independent Rust cases with up to $JOBS workers"
  "$ROOT/scripts/ci-cases" pool "$LOGS" "$JOBS" "${selected_rows[@]}" >"$LOGS/case-pool.log" 2>&1 &
  POOL_PID=$!
}

cases_finish() {
  ((POOL_PID)) || return 0
  wait "$POOL_PID" || log "some Rust case workers failed; see their case logs"
  POOL_PID=0
  local row name line
  for row in "${POOL_ROWS[@]}"; do
    name="$(row_name "$row")"
    STEP=$((STEP + 1))
    SEEN_STEPS["$name"]=1
    line="$(awk -v name="$name" 'index($0, name) == 1 && $0 ~ / (pass|FAIL) / {print}' "$LOGS/$row/summary.txt" 2>/dev/null)" || line=
    if [[ -z "$line" ]]; then
      FAILED=$((FAILED + 1))
      ROWS+=("$(printf '%-38s %-5s %7s %7s %8s %6ss  %s' "$name" FAIL 0 0 0 0 "missing worker summary: ${LOGS#"$ROOT"/}/$row")")
    else
      ROWS+=("$line")
      [[ "$line" != *" FAIL "* ]] || FAILED=$((FAILED + 1))
    fi
  done
}

python_checks() {
  (cd "$ROOT/connectors" &&
    unset PYTHONPATH &&
    uv sync --locked --all-extras &&
    uv run --locked --all-extras mypy &&
    uv run --locked --all-extras ruff check . ../crates/fyrr/tests/providers ../scripts/ci-cases ../scripts/check-docs &&
    uv run --locked --all-extras ruff format --check . ../crates/fyrr/tests/providers ../scripts/ci-cases ../scripts/check-docs &&
    "$ROOT/scripts/ci-cases" run python-sdk)
}

# The example provider's own tests, with the SDK's provider test kit.
example_provider() {
  (cd "$ROOT/examples/markdown-provider" &&
    uv sync --locked &&
    uv run --locked ruff check &&
    uv run --locked ruff format --check &&
    "$ROOT/scripts/ci-cases" run python-example)
}

# The example wheel, built outside the workspace, installed into its own
# directory and used by the already-built full binary: provider listed and
# the Markdown source synced (dry run).
example_wheels() {
  local wheels="$ROOT/target/example-wheels" site="$ROOT/target/example-site" config output
  rm -rf "$wheels" "$site"
  uv build --wheel --quiet --out-dir "$wheels" "$ROOT/examples/markdown-provider" || return 1
  uv pip install --quiet --no-deps --python "$ROOT/connectors/.venv/bin/python" \
    --target "$site" "$wheels"/*.whl || return 1
  ensure_build || return 1
  config="$site/fyrr.toml"
  printf '%s\n' '[namespace]' 'name = "dev"' '[storage]' 'uri = "s3://fyrr-dev/dev"' \
    '[identity]' 'hashing_key = { env = "FYRR_EXAMPLE_HASHING_KEY" }' \
    '[embedding]' 'endpoint = "https://embeddings.invalid/v1"' '[[sources]]' 'id = "handbook"' \
    'type = "markdown-dir"' 'permissions = "fixed"' 'readers = ["grp:engineering"]' \
    '[sources.scope]' "root = \"$ROOT/examples/markdown-provider/tests/data\"" >"$config"
  run_fyrr() {
    VIRTUAL_ENV="$ROOT/connectors/.venv" PYTHONPATH="$site" PYTHONDONTWRITEBYTECODE=1 \
      FYRR_EXAMPLE_HASHING_KEY=example-wheels-key \
      "$ROOT/target/ci-build/full/fyrr" "$@"
  }
  output="$(run_fyrr writer providers)"
  echo "$output"
  grep -qE '^markdown-dir +fyrr-provider-markdown +0\.1\.0 .* ok$' <<<"$output" &&
    output="$(run_fyrr --config "$config" writer sync --dry-run)" &&
    printf '%s\n' "$output" &&
    grep -q 'upserts=2' <<<"$output" &&
    grep -q 'dry run: 1 source(s) passed, 0 failed' <<<"$output"
}

# A check this run did not perform: listed as n/e (not evaluated), never as
# passed.
not_evaluated() {
  SEEN_STEPS["$1"]=1
  STEP=$((STEP + 1))
  ROWS+=("$(printf '%-38s %-5s %7s %7s %8s %6ss  %s' "$1" "n/e" - - - 0 "$2")")
  log "step $STEP: $1 not evaluated ($2)"
}

finish_summary() {
  for name in "${!REQUESTED_STEPS[@]}"; do
    if [[ ! ${SEEN_STEPS["$name"]+known} ]]; then
      log "unknown CI step: $name"
      FAILED=$((FAILED + 1))
    fi
  done

  {
    echo "fyrr ci $STAMP  tier $TIER  commit ${FYRR_CI_REVISION:-$(git rev-parse --short HEAD 2>/dev/null || echo unavailable)}  $(rustc --version)"
    printf '%-38s %-5s %7s %7s %8s %7s  %s\n' step status passed failed ignored time log
    printf '%s\n' "${ROWS[@]}"
    echo "steps: $STEP, failed: $FAILED"
  } | tee "$LOGS/summary.txt"

  if ((FAILED > 0)); then
    log "ci FAILED ($FAILED step(s)); full logs in ${LOGS#"$ROOT"/}"
    exit 1
  fi
  log "ci passed; full logs in ${LOGS#"$ROOT"/}"
}

log "fyrr ci: logs in ${LOGS#"$ROOT"/}"
if [[ -n "$CASE_ROW" ]]; then
  cases_start
  finish_summary
  exit
fi
step "doctor" none "$ROOT/scripts/doctor"
if ((!ONLY_STEPS)); then step "build test executables" none ensure_build; fi
cases_start
step "rustfmt" none cargo fmt --all --check
step "clippy (full workspace)" none cargo clippy --locked --workspace --all-targets -- -D warnings
step "clippy (reader-only build)" none cargo clippy --locked --workspace --no-default-features --all-targets -- -D warnings
step "test-case ownership guard" none ownership_check
step "reference docs" none reference_docs
step "reader-only link check" none reader_link_check
step "licenses and advisories" none cargo deny --locked check
step "python connector SDK" pytest python_checks
step "example provider (test kit)" pytest example_provider
step "example wheels without rebuild" none example_wheels
if ((IMAGES && !DEBUG_ONLY)); then
  step "images (build, derived, compose)" none "$ROOT/scripts/images"
else
  reason="not selected; use --images for release checks"
  ((DEBUG_ONLY == 0)) || reason="skipped by --debug-only"
  not_evaluated "images (build, derived, compose)" "$reason"
fi
step "quickstart example (local storage)" none quickstart
cases_finish

finish_summary
