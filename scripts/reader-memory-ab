#!/usr/bin/env python3
"""Compare reader memory envelopes with frozen vectors over the real MCP path.

Use an owned index copy and a TOML template containing @@MEMORY@@ and
@@EMBEDDING_ENDPOINT@@ once each. This diagnostic makes no external API calls.
It retains four fresh-process arms (A, B, B, A); it does not tune retrieval.
"""

import argparse
import hashlib
import json
import math
import os
import queue
import random
import subprocess
import threading
import time
import tomllib
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from typing import ClassVar


def digest(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def write(path, value):
    path.write_text(json.dumps(value, indent=2) + "\n")


class Replay(BaseHTTPRequestHandler):
    vectors: ClassVar[dict[str, list[float]]] = {}
    model = ""
    unknown: ClassVar[list[str]] = []

    def log_message(self, *args):
        pass

    def reply(self, status, body):
        encoded = json.dumps(body).encode()
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(encoded)))
        self.end_headers()
        self.wfile.write(encoded)

    def do_GET(self):
        self.reply(200, {"data": [{"id": self.model}]})

    def do_POST(self):
        request = json.loads(self.rfile.read(int(self.headers["Content-Length"])))
        inputs = request.get("input", [])
        if isinstance(inputs, str):
            inputs = [inputs]
        if (
            request.get("model") != self.model
            or request.get("input_type") != "query"
            or any(text not in self.vectors for text in inputs)
        ):
            self.unknown.append("provider_input_mismatch")
            self.reply(400, {"error": "provider_input_mismatch"})
            return
        self.reply(
            200,
            {
                "model": self.model,
                "data": [
                    {"index": index, "embedding": self.vectors[text]}
                    for index, text in enumerate(inputs)
                ],
            },
        )


class Reader:
    def __init__(self, binary, config, directory, cpus):
        self.stderr = (directory / "stderr.log").open("w")
        env = dict(os.environ, LANCE_CPU_THREADS=str(len(cpus)))
        env.pop("FYRR_OBJECT_STORE_DIAGNOSTICS", None)
        self.process = subprocess.Popen(
            [
                "taskset",
                "-c",
                ",".join(map(str, cpus)),
                str(binary),
                "--config",
                str(config),
                "reader",
                "serve",
            ],
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=self.stderr,
            text=True,
            bufsize=1,
            env=env,
        )
        self.responses = queue.Queue()
        self.reader_thread = threading.Thread(target=self.read, daemon=True)
        self.reader_thread.start()
        self.counter = 0
        try:
            self.rpc(
                "initialize",
                {
                    "protocolVersion": "2025-03-26",
                    "capabilities": {},
                    "clientInfo": {"name": "memory-diagnostic", "version": "1"},
                },
            )
            self.send({"jsonrpc": "2.0", "method": "notifications/initialized"})
        except Exception:
            self.close()
            raise

    def read(self):
        try:
            for line in self.process.stdout:
                self.responses.put(json.loads(line))
        finally:
            self.responses.put(None)

    def send(self, message):
        self.process.stdin.write(json.dumps(message) + "\n")
        self.process.stdin.flush()

    def rpc(self, method, params):
        self.counter += 1
        self.send(
            {"jsonrpc": "2.0", "id": self.counter, "method": method, "params": params}
        )
        expires = time.monotonic() + 360
        while time.monotonic() < expires:
            try:
                response = self.responses.get(
                    timeout=max(0, expires - time.monotonic())
                )
            except queue.Empty:
                break
            if response is None:
                raise RuntimeError("reader_closed_stdout")
            if response.get("id") == self.counter:
                if "error" in response:
                    raise RuntimeError("mcp_rpc_error")
                return response["result"]
        raise RuntimeError("reader_response_timeout")

    def search(self, query):
        result = self.rpc(
            "tools/call",
            {
                "name": "search",
                "arguments": {
                    "query": query,
                    "limit": 50,
                    "output": "metadata",
                    "deadline_ms": 10000,
                },
            },
        )
        value = result.get("structuredContent")
        if value is None:
            value = json.loads(
                next(
                    item["text"]
                    for item in result["content"]
                    if item.get("type") == "text"
                )
            )
        if result.get("isError"):
            return {"status": "error", "response": value}
        return {
            "status": "ok",
            "hits": [
                {
                    key: hit[key]
                    for key in (
                        "source_id",
                        "root_id",
                        "record_id",
                        "revision",
                        "score",
                    )
                }
                for hit in value["hits"]
            ],
            "metadata": value["metadata"],
            "truncated": value.get("truncated"),
        }

    def close(self):
        self.process.stdin.close()
        try:
            self.process.wait(timeout=30)
        except subprocess.TimeoutExpired:
            self.process.kill()
            self.process.wait()
        self.reader_thread.join(timeout=10)
        self.process.stdout.close()
        self.stderr.close()


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--binary", type=Path, required=True)
    parser.add_argument("--config-template", type=Path, required=True)
    parser.add_argument("--questions", type=Path, required=True)
    parser.add_argument("--vectors", type=Path, required=True)
    parser.add_argument("--output", type=Path, required=True)
    parser.add_argument("--model", default="voyage-4")
    parser.add_argument("--cpus", type=int, default=2)
    args = parser.parse_args()
    available = next(
        int(line.split()[1]) * 1024
        for line in Path("/proc/meminfo").read_text().splitlines()
        if line.startswith("MemAvailable:")
    )
    if available < 8 * 1024**3:
        raise RuntimeError("MemAvailable_below_8_GiB")
    args.output.mkdir(mode=0o700, parents=True, exist_ok=False)
    write(
        args.output / "host.json",
        {
            "kernel": os.uname().release,
            "architecture": os.uname().machine,
            "cpu_model": next(
                line.split(":", 1)[1].strip()
                for line in Path("/proc/cpuinfo").read_text().splitlines()
                if line.startswith("model name")
            ),
            "memory_available_bytes": available,
            "loadavg": Path("/proc/loadavg").read_text().strip(),
            "processes": subprocess.check_output(
                ["ps", "-eo", "pid,comm,pcpu,pmem"], text=True
            ),
        },
    )
    template = args.config_template.read_text()
    for marker in ("@@MEMORY@@", "@@EMBEDDING_ENDPOINT@@"):
        if template.count(marker) != 1:
            raise ValueError("template_marker_count_invalid")
    questions = [json.loads(line) for line in args.questions.read_text().splitlines()]
    random.Random(1729).shuffle(questions)
    frozen = json.loads(args.vectors.read_text())
    if len({q["question"] for q in questions}) != len(questions):
        raise ValueError("duplicate_questions")
    if frozen.get("model") != args.model or frozen.get("input_type") != "query":
        raise ValueError("frozen_provider_identity_mismatch")
    Replay.vectors = frozen["vectors"]
    Replay.model = args.model
    if set(Replay.vectors) != {q["question"] for q in questions}:
        raise ValueError("frozen_query_set_mismatch")
    for vector in Replay.vectors.values():
        if (
            len(vector) != 1024
            or not all(math.isfinite(value) for value in vector)
            or not any(vector)
        ):
            raise ValueError("frozen_vector_invalid")
    if args.cpus < 1:
        raise ValueError("cpu_count_invalid")
    cpus = sorted(os.sched_getaffinity(0))[: args.cpus]
    server = ThreadingHTTPServer(("127.0.0.1", 0), Replay)
    thread = threading.Thread(target=server.serve_forever, daemon=True)
    thread.start()
    endpoint = f"http://127.0.0.1:{server.server_address[1]}/v1"
    identity = {
        "binary_sha256": digest(args.binary),
        "driver_sha256": digest(Path(__file__)),
        "questions_sha256": digest(args.questions),
        "vectors_sha256": digest(args.vectors),
        "config_template_sha256": digest(args.config_template),
        "cpus": cpus,
        "lance_cpu_threads": len(cpus),
        "seed": 1729,
        "deadline_ms": 10000,
        "arms": ["2304MiB", "1536MiB", "1536MiB", "2304MiB"],
        "external_provider_calls_during_arms": 0,
    }
    write(args.output / "identity.json", identity)
    results = []
    try:
        for index, memory in enumerate(identity["arms"]):
            directory = args.output / f"arm-{index + 1}"
            directory.mkdir()
            config = directory / "reader.toml"
            config.write_text(
                template.replace("@@MEMORY@@", memory).replace(
                    "@@EMBEDDING_ENDPOINT@@", endpoint
                )
            )
            parsed = tomllib.loads(config.read_text())
            if results:
                previous = tomllib.loads(
                    (args.output / "arm-1/reader.toml").read_text()
                )
                previous["reader"]["memory_max_bytes"] = memory
                if parsed != previous:
                    raise ValueError("arms_differ_beyond_memory")
            env = dict(os.environ, LANCE_CPU_THREADS=str(len(cpus)))
            env.pop("FYRR_OBJECT_STORE_DIAGNOSTICS", None)
            checked = subprocess.run(
                [
                    "taskset",
                    "-c",
                    ",".join(map(str, cpus)),
                    str(args.binary.resolve()),
                    "--config",
                    str(config.resolve()),
                    "reader",
                    "check",
                ],
                capture_output=True,
                check=False,
                text=True,
                env=env,
                timeout=360,
            )
            write(
                directory / "readiness.json",
                {
                    "exit_code": checked.returncode,
                    "stdout": checked.stdout,
                    "stderr": checked.stderr,
                },
            )
            if checked.returncode:
                raise RuntimeError("reader_not_ready")
            reader = Reader(args.binary.resolve(), config.resolve(), directory, cpus)
            rows = []
            try:
                write(
                    directory / "inventory.json",
                    reader.rpc("tools/call", {"name": "list_filters", "arguments": {}}),
                )
                write(
                    directory / "warmup.json", reader.search(questions[0]["question"])
                )
                with (directory / "responses.jsonl").open("w") as output:
                    for question in questions:
                        row = {
                            "question_id": question["question_id"],
                            **reader.search(question["question"]),
                        }
                        rows.append(row)
                        output.write(json.dumps(row) + "\n")
                        output.flush()
            finally:
                reader.close()
            if Replay.unknown:
                raise ValueError("provider_inputs_changed")
            results.append(rows)
            print(
                json.dumps(
                    {
                        "arm": index + 1,
                        "memory": memory,
                        "responses": len(rows),
                        "ok": sum(row["status"] == "ok" for row in rows),
                    }
                ),
                flush=True,
            )
    finally:
        server.shutdown()
        server.server_close()
        thread.join()
    comparisons = []
    for left, right in ((0, 1), (0, 2), (0, 3), (1, 2)):
        different = []
        different_order = []
        for a, b in zip(results[left], results[right], strict=True):
            if a.get("hits") != b.get("hits") or a["status"] != b["status"]:
                different.append(a["question_id"])
            keys = lambda row: [
                (hit["source_id"], hit["root_id"], hit["record_id"])
                for hit in row.get("hits", [])
            ]
            if keys(a) != keys(b) or a["status"] != b["status"]:
                different_order.append(a["question_id"])
        comparisons.append(
            {
                "arms": [left + 1, right + 1],
                "different_hits_or_scores": different,
                "different_rank_order": different_order,
            }
        )
    write(args.output / "comparison.json", comparisons)


if __name__ == "__main__":
    main()
