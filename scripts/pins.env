# Pinned external tools, sourced by scripts/lib.sh. Change a pin only together
# with its checksum or digest.

# protoc for Lance's protobuf build scripts, one archive per build host
# (scripts/lib.sh ensure_protoc selects by `uname -m`).
PROTOC_VERSION=32.1
PROTOC_URL_X86_64=https://github.com/protocolbuffers/protobuf/releases/download/v32.1/protoc-32.1-linux-x86_64.zip
PROTOC_SHA256_X86_64=e9c129c176bb7df02546c4cd6185126ca53c89e7d2f09511e209319704b5dd7e
PROTOC_URL_AARCH64=https://github.com/protocolbuffers/protobuf/releases/download/v32.1/protoc-32.1-linux-aarch_64.zip
PROTOC_SHA256_AARCH64=4a802ed23d70f7bad7eb19e5a3e724b3aa967250d572cadfd537c1ba939aee6a

# RustFS S3 fixture image (RustFS 1.0.0, linux/amd64 and linux/arm64), pinned by digest.
RUSTFS_IMAGE=rustfs/rustfs@sha256:8cc9801755448b71a786705ce76692c77e14936cccd87cf2fc31842e58f4d1ff

# glibc of the Debian 13 runtime images (docker/Dockerfile). A prebuilt binary
# that needs a newer symbol version cannot be packaged into them.
IMAGE_GLIBC=2.41

# cargo-deny for license and advisory verdicts (cargo install --locked cargo-deny@0.20.2).
CARGO_DENY_VERSION=0.20.2
CARGO_DENY_URL=https://github.com/EmbarkStudios/cargo-deny/releases/download/0.20.2/cargo-deny-0.20.2-x86_64-unknown-linux-musl.tar.gz
CARGO_DENY_SHA256=9f12ed4c49936e09b48bf862b595cde2fe64fcbd9d74dfacac6131ca824c8d5f

# Keycloak 26.7.5, linux/amd64, owned loopback identity fixture.
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak@sha256:6529db34610ce6328824218dce3bbe55c4ba4757bc5c8a09b5a4c746e28b6e9d

# Helm renders and lints deploy/helm/fyrr (scripts/lib.sh ensure_helm), one archive per build host.
HELM_VERSION=3.22.1
HELM_URL_X86_64=https://get.helm.sh/helm-v3.22.1-linux-amd64.tar.gz
HELM_SHA256_X86_64=896cf63684a42a723d61c980369d6e588330927deb13676ca0d85006dd6da0ea
HELM_URL_AARCH64=https://get.helm.sh/helm-v3.22.1-linux-arm64.tar.gz
HELM_SHA256_AARCH64=4c29e286b279d170fa048ddfc3e4e83dcd069ca9c52102766ba672d7149e694d
