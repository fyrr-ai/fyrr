#!/usr/bin/env python3
"""Measure how much token positions add to the full-text index.

The native `fyrr writer serve` runs on local storage and this script only
drives it and sizes the files it wrote. It fetches the corpus (the 5,183
abstracts of BEIR SciFact, from the public dataset BeIR/scifact), writes it
twice as one request of rows with a title and an abstract as their text, once
to a namespace without `fts_positions` and once to one with it, and sums the
bytes of the files of the full-text index of `searchable_text` in each. The
vectors are random and the same in both runs: they are no part of the
measurement.

  scripts/bench-fts-positions --binary target/release/fyrr

Output is one JSON document on stdout and a table on stderr. The data is
removed when the script ends.
"""

import argparse
import http.client
import json
import os
import platform
import random
import secrets
import shutil
import socket
import subprocess
import sys
import tempfile
import time
import urllib.request
from pathlib import Path

DIMENSIONS = 128
NAMESPACE = "bench-positions"
ROOT = Path(__file__).resolve().parent.parent
PAGE = 100  # rows the dataset server returns per request, at most
ROWS_URL = (
    "https://datasets-server.huggingface.co/rows?dataset=BeIR/scifact"
    "&config=corpus&split=corpus&offset=%d&length=%d"
)
# A Lance inverted index keeps its postings, and with them the positions, in a
# file that ends with this name.
POSTINGS = "invert.lance"


def free_address():
    with socket.socket() as probe:
        probe.bind(("127.0.0.1", 0))
        return "127.0.0.1:%d" % probe.getsockname()[1]


def fetch_corpus(limit):
    """(id, text) of up to `limit` documents of the dataset, in its order."""
    documents = []
    while limit is None or len(documents) < limit:
        want = PAGE if limit is None else min(PAGE, limit - len(documents))
        with urllib.request.urlopen(
            ROWS_URL % (len(documents), want), timeout=120
        ) as r:
            page = json.load(r)
        if not page["rows"]:
            break
        for entry in page["rows"]:
            row = entry["row"]
            documents.append((row["_id"], row["title"] + "\n" + row["text"]))
        if len(documents) >= page["num_rows_total"]:
            break
    return documents


def index_files(storage):
    """The files of every full-text index under `storage`: the directories of
    `_indices` that hold a file of postings."""
    found = {"files": 0, "bytes": 0, "postings_bytes": 0}
    for directory in storage.rglob("_indices/*"):
        if not directory.is_dir():
            continue
        files = [f for f in directory.rglob("*") if f.is_file()]
        if not any(f.name.endswith(POSTINGS) for f in files):
            continue
        for f in files:
            size = f.stat().st_size
            found["files"] += 1
            found["bytes"] += size
            if f.name.endswith(POSTINGS):
                found["postings_bytes"] += size
    return found


def build(binary, documents, positions):
    """Writes the documents to a new namespace and returns its full-text index size."""
    # Local storage refuses a path with a symlink in it, and `target` may be one.
    work = Path(
        tempfile.mkdtemp(prefix="fts-positions-", dir=ROOT / "target")
    ).resolve()
    work.chmod(0o700)
    address = free_address()
    config = work / "fyrr.toml"
    # The index build uses at most 2 threads: more hard-reset the host.
    config.write_text(
        '[namespace]\nname = "%s"\nfts_positions = %s\n[storage]\nuri = "file://%s"\n'
        '[embedding]\nendpoint = "http://127.0.0.1:9/v1"\nmodel = "caller-supplied"\n'
        "dimensions = %d\n"
        '[identity]\nhashing_key = { env = "FYRR_BENCH_HASHING_KEY" }\n'
        'encryption_key = { env = "FYRR_BENCH_ENCRYPTION_KEY" }\n'
        "[namespace.write_api]\nopen = true\n"
        "[[identity.api_keys]]\nname = 'writer'\nkey = { env = 'FYRR_BENCH_WRITE_KEY' }\n"
        "roles = ['write']\n"
        "[writer]\nthreads = 2\n"
        "[writer.serve.admin]\nlisten = '%s'\noperator_token = { env = 'FYRR_BENCH_OPERATOR' }\n"
        % (
            NAMESPACE,
            "true" if positions else "false",
            work / "storage",
            DIMENSIONS,
            address,
        )
    )
    key = "fyrr_key_" + secrets.token_hex(32)
    env = dict(
        os.environ,
        FYRR_BENCH_HASHING_KEY=secrets.token_hex(32),
        FYRR_BENCH_ENCRYPTION_KEY=secrets.token_hex(32),
        FYRR_BENCH_WRITE_KEY=key,
        FYRR_BENCH_OPERATOR=secrets.token_hex(16),
        VIRTUAL_ENV=str(ROOT / "connectors/.venv"),
    )
    base = [str(binary), "--config", str(config)]
    rng = random.Random(1729)
    rows = [
        {
            "id": identifier,
            "text": text,
            "vector": [round(rng.gauss(0, 1), 4) for _ in range(DIMENSIONS)],
        }
        for identifier, text in documents
    ]
    body = json.dumps({"upserts": rows}).encode()
    writer = None
    try:
        keys = subprocess.run(
            [*base, "writer", "keys"], env=env, capture_output=True, text=True
        )
        if keys.returncode:
            raise SystemExit("writer keys failed: " + keys.stderr)
        writer = subprocess.Popen(
            [*base, "writer", "serve", "--jobs", "1"],
            env=env,
            stdout=subprocess.DEVNULL,
            stderr=(work / "writer.stderr").open("w"),
        )
        host, port = address.split(":")
        for _ in range(600):
            try:
                connection = http.client.HTTPConnection(host, int(port), timeout=3600)
                started = time.perf_counter()
                connection.request(
                    "POST",
                    "/v1/namespaces/%s/documents" % NAMESPACE,
                    body,
                    {
                        "Authorization": "Bearer " + key,
                        "Content-Type": "application/json",
                    },
                )
                response = connection.getresponse()
                answer = response.read()
                took = time.perf_counter() - started
                break
            except OSError:
                time.sleep(0.1)
        else:
            raise SystemExit("the writer did not come up")
        assert response.status == 200, (response.status, answer)
        print(
            "fts_positions=%s: wrote %d rows (%.0f s)" % (positions, len(rows), took),
            file=sys.stderr,
            flush=True,
        )
    finally:
        if writer:
            writer.terminate()
            writer.wait(timeout=120)
    try:
        return index_files(work / "storage")
    finally:
        shutil.rmtree(work)


def machine():
    cpu = next(
        (
            line.split(":", 1)[1].strip()
            for line in Path("/proc/cpuinfo").read_text().splitlines()
            if line.startswith("model name")
        ),
        "unknown",
    )
    return {"kernel": platform.release(), "cpu": cpu, "logical_cpus": os.cpu_count()}


def main():
    parser = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    parser.add_argument("--binary", default=str(ROOT / "target/release/fyrr"))
    parser.add_argument(
        "--rows", type=int, help="the first rows of the corpus; default all"
    )
    args = parser.parse_args()
    binary = Path(args.binary).resolve()
    documents = fetch_corpus(args.rows)
    characters = sum(len(text) for _, text in documents)
    without = build(binary, documents, False)
    with_positions = build(binary, documents, True)
    version = subprocess.run(
        [str(binary), "--version"], capture_output=True, text=True, check=True
    ).stdout.strip()
    commit = subprocess.run(
        ["git", "-C", str(ROOT), "rev-parse", "--short", "HEAD"],
        capture_output=True,
        text=True,
    ).stdout.strip()
    report = {
        "corpus": "BeIR/scifact",
        "documents": len(documents),
        "text_characters": characters,
        "without_positions": without,
        "with_positions": with_positions,
        "growth": round(with_positions["bytes"] / without["bytes"], 3),
        "version": version,
        "commit": commit,
        "machine": machine(),
    }
    print(json.dumps(report, indent=2))
    print(
        "%d documents, %d characters of text\n"
        "full-text index without positions: %d bytes (postings %d)\n"
        "full-text index with positions:    %d bytes (postings %d)\n"
        "growth: x%.3f"
        % (
            len(documents),
            characters,
            without["bytes"],
            without["postings_bytes"],
            with_positions["bytes"],
            with_positions["postings_bytes"],
            report["growth"],
        ),
        file=sys.stderr,
    )


if __name__ == "__main__":
    main()
