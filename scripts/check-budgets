#!/usr/bin/env bash
# Dependency-count and binary-size budgets measure both builds of the
# fyrr binary and compare with budgets.toml. Growth fails until budgets.toml
# records the new measured value in the same change (raise a value only by its
# measured delta). Shrinking passes with a note to lower the budget.
#
#   scripts/check-budgets            measure and compare
#   scripts/check-budgets --record   measure and write the values to budgets.toml
#
# Dependency count: unique packages (name, version, source) in the non-dev
# dependency graph of the binary, workspace crates included.
# Binary size: bytes of the stripped release binary (profile.release).
source "$(dirname "${BASH_SOURCE[0]}")/lib.sh"

OUT="$ROOT/target/budget"
mkdir -p "$OUT"

dependency_count() {
  cargo tree --locked -p fyrr -e normal,build --prefix none -f '{p}' "$@" \
    | sed 's/ (\*)$//' | sort -u | grep -c .
}

binary_size() {
  local variant="$1"
  shift
  build_release -p fyrr "$@" >&2 || return
  cp "$ROOT/target/release/fyrr" "$OUT/fyrr-$variant" || return
  stat -c %s "$OUT/fyrr-$variant"
}

declare -A measured
measured[dependencies.full]="$(dependency_count)"
measured[dependencies.reader_only]="$(dependency_count --no-default-features)"
log "building release binaries for the size budget"
measured[binary_size.full]="$(binary_size full)"
measured[binary_size.reader_only]="$(binary_size reader-only --no-default-features)"

if [[ "${1:-}" == "--record" ]]; then
  for key in "${!measured[@]}"; do
    set_budget "${key%%.*}" "${key#*.}" "${measured[$key]}"
  done
  log "recorded measured values in budgets.toml"
fi

status=0
for key in dependencies.full dependencies.reader_only binary_size.full binary_size.reader_only; do
  compare_budget "${key%%.*}" "${key#*.}" "${measured[$key]}" || status=1
done
exit "$status"
