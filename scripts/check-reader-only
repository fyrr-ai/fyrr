#!/usr/bin/env bash
# Proves the reader-only build (`--no-default-features`, the fyrr-reader
# image) links no writer crate, Python or PyO3, twice:
# 1. dependency graph: no forbidden crate in the reader-only build's normal
#    and build dependencies (a crate outside the graph cannot be linked);
# 2. linked binary: the debug reader-only binary has no libpython in its
#    dynamic section (DT_NEEDED), with the full debug binary as a control.
# The internal evaluation tool remains outside the product dependency graph.
source "$(dirname "${BASH_SOURCE[0]}")/lib.sh"
cd "$ROOT"

FORBIDDEN='^(fyrr-writer|pyo3|pyo3-ffi|pyo3-macros|pyo3-build-config|python3-dll-a|arrow-pyarrow|numpy) '

graph() {
  cargo tree --locked -p fyrr -e normal,build --prefix none -f '{p}' "$@" | sed 's/ (\*)$//' | sort -u
}

reader="$(graph --no-default-features)"
full="$(graph)"

for crate in fyrr-writer pyo3 pyo3-ffi arrow-pyarrow; do
  grep -q "^$crate " <<<"$full" || die "control failed: the full build's graph has no $crate, so this check proves nothing"
done
echo "control: the full build's graph contains fyrr-writer, pyo3, pyo3-ffi and arrow-pyarrow"

if offenders="$(grep -E "$FORBIDDEN" <<<"$reader")"; then
  echo "FAIL: the reader-only build depends on:" >&2
  echo "$offenders" >&2
  exit 1
fi
echo "ok: the reader-only build's graph ($(grep -c . <<<"$reader") packages) contains no fyrr-writer, Python or PyO3 crate"

if grep -q '^fyrr-eval ' <<<"$full"; then
  die "the full build's graph contains fyrr-eval"
fi
cargo metadata --locked --no-deps --format-version 1 | python3 -c '
import json, sys
packages = {p["name"]: p for p in json.load(sys.stdin)["packages"]}
if "fyrr-eval" not in packages:
    sys.exit("control failed: the workspace has no fyrr-eval package")
for name in ("fyrr", "fyrr-reader", "fyrr-writer", "fyrr-core"):
    if "evaluation" in packages[name]["features"]:
        sys.exit(f"FAIL: {name} declares an evaluation feature")
' || exit 1
echo "ok: no product crate declares an evaluation feature or depends on fyrr-eval"

# Development instrumentation must stay out of both shipping package graphs.
for variant in full reader; do
  flags=()
  [[ "$variant" == full ]] || flags+=(--no-default-features)
  features="$(cargo tree --locked -p fyrr -e normal,build --prefix none -f '{p} features={f}' "${flags[@]}")"
  if grep -Eq 'features=([^ ]*,)?test-store(,|$)' <<<"$features"; then
    die "$variant normal/build graph enables test-store"
  fi
done
dev="$(cargo tree --locked -p fyrr -e normal,build,dev --prefix none -f '{p} features={f}')"
grep -Eq '^fyrr-reader .*features=([^ ]*,)?test-store(,|$)' <<<"$dev" ||
  die "control failed: the dev graph does not enable test-store"
echo "ok: test-store is dev-only; both shipping graphs exclude it"

needed() {
  readelf --dynamic "$1" | sed -n 's/.*(NEEDED).*\[\(.*\)\]/\1/p'
}

[[ $# == 0 ]] || die "usage: scripts/check-reader-only"
# The same artifacts used by CI's owned tests; graph and dynamic linkage do
# not require optimization or LTO.
if [[ "${FYRR_CI_PREBUILT:-}" != 1 ]]; then
  "$ROOT/scripts/ci-cases" build
fi
full_needed="$(needed "$ROOT/target/ci-build/full/fyrr")"
grep -q '^libpython' <<<"$full_needed" || die "full debug control needs no libpython"
reader_needed="$(needed "$ROOT/target/ci-build/reader/fyrr")"
if grep -qi python <<<"$reader_needed"; then die "reader-only debug binary links Python"; fi
echo "control: the full debug binary needs $(grep '^libpython' <<<"$full_needed")"
echo "ok: the reader-only debug binary needs only: $(tr '\n' ' ' <<<"$reader_needed")"
