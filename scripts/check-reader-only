#!/usr/bin/env bash
# Proves the reader-only build (`--no-default-features`, the fyrr-reader
# image) contains no writer and no provider code, and that neither build
# links Python, in three ways:
# 1. dependency graph: no writer crate in the reader-only build's normal and
#    build dependencies (a crate outside the graph cannot be linked), and no
#    Python-binding crate in either build;
# 2. linked binaries: neither debug binary has libpython in its dynamic
#    section (DT_NEEDED);
# 3. content: only the full debug binary holds the writer's provider-host
#    entry point name, with the full binary as the control.
source "$(dirname "${BASH_SOURCE[0]}")/lib.sh"
cd "$ROOT"

WRITER='^fyrr-writer '
PYTHON_BINDINGS='^(pyo3|pyo3-ffi|pyo3-macros|pyo3-build-config|python3-dll-a|arrow-pyarrow|numpy) '

graph() {
  cargo tree --locked -p fyrr -e normal,build --prefix none -f '{p}' "$@" | sed 's/ (\*)$//' | sort -u
}

reader="$(graph --no-default-features)"
full="$(graph)"

grep -Eq "$WRITER" <<<"$full" || die "control failed: the full build's graph has no fyrr-writer, so this check proves nothing"
echo "control: the full build's graph contains fyrr-writer"

if offenders="$(grep -E "$WRITER" <<<"$reader")"; then
  echo "FAIL: the reader-only build depends on:" >&2
  echo "$offenders" >&2
  exit 1
fi
echo "ok: the reader-only build's graph ($(grep -c . <<<"$reader") packages) contains no writer crate"

if offenders="$(grep -E "$PYTHON_BINDINGS" <<<"$full")"; then
  echo "FAIL: the full build depends on Python bindings:" >&2
  echo "$offenders" >&2
  exit 1
fi
echo "ok: neither build's graph contains a Python binding crate (PyO3, arrow-pyarrow)"

# Development instrumentation must stay out of both shipping package graphs.
for variant in full reader; do
  flags=()
  [[ "$variant" == full ]] || flags+=(--no-default-features)
  features="$(cargo tree --locked -p fyrr -e normal,build --prefix none -f '{p} features={f}' "${flags[@]}")"
  if grep -Eq 'features=([^ ]*,)?(test-store|test-clock)(,|$)' <<<"$features"; then
    die "$variant normal/build graph enables test-store or test-clock"
  fi
done
dev="$(cargo tree --locked -p fyrr -e normal,build,dev --prefix none -f '{p} features={f}')"
grep -Eq '^fyrr-reader .*features=([^ ]*,)?test-store(,|$)' <<<"$dev" ||
  die "control failed: the dev graph does not enable test-store"
grep -Eq '^fyrr-core .*features=([^ ]*,)?test-clock(,|$)' <<<"$dev" ||
  die "control failed: the dev graph does not enable test-clock"
echo "ok: test-store and test-clock are dev-only; both shipping graphs exclude them"

needed() {
  readelf --dynamic "$1" | sed -n 's/.*(NEEDED).*\[\(.*\)\]/\1/p'
}

[[ $# == 0 ]] || die "usage: scripts/check-reader-only"
# The same artifacts used by CI's owned tests; graph and dynamic linkage do
# not require optimization or LTO.
if [[ "${FYRR_CI_PREBUILT:-}" != 1 ]]; then
  "$ROOT/scripts/ci-cases" build
fi
full_needed="$(needed "$ROOT/target/ci-build/full/fyrr")"
reader_needed="$(needed "$ROOT/target/ci-build/reader/fyrr")"
[[ -n "$full_needed" ]] || die "control failed: the full debug binary lists no needed libraries"
if grep -qi python <<<"$full_needed"; then die "full debug binary links Python"; fi
if grep -qi python <<<"$reader_needed"; then die "reader-only debug binary links Python"; fi
echo "ok: the full debug binary needs only: $(tr '\n' ' ' <<<"$full_needed")"
echo "ok: the reader-only debug binary needs only: $(tr '\n' ' ' <<<"$reader_needed")"

MARKER='fyrr_connectors.host'
LC_ALL=C grep -aFq "$MARKER" "$ROOT/target/ci-build/full/fyrr" || die "control failed: the full debug binary does not hold the provider-host entry point name"
if LC_ALL=C grep -aFq "$MARKER" "$ROOT/target/ci-build/reader/fyrr"; then die "reader-only debug binary holds provider-host code"; fi
echo "ok: only the full debug binary holds the provider-host entry point name ($MARKER)"
