#!/usr/bin/env python3
"""Enumerate executable cases and run the committed, disjoint CI ownership rows.

A row owns the cases under its module prefixes in `scripts/ci-cases.json`; only
exceptions are listed one by one.
"""

import asyncio
import collections
import contextlib
import datetime
import filecmp
import hashlib
import json
import math
import os
import re
import shutil
import signal
import subprocess
import sys
import tempfile
import time
import tomllib
from pathlib import Path
from urllib.parse import quote, unquote

ROOT = Path(__file__).resolve().parent.parent
os.environ["PATH"] = f"{Path.home() / '.cargo/bin'}:{os.environ['PATH']}"
os.environ["MBX_TARGET_VIEWS"] = "0"
os.environ.setdefault("MBX_GC_MAX_SIZE", "40GiB")
os.environ.setdefault("MBX_GC_MIN_FREE_SIZE", "12GiB")
os.environ.setdefault("CARGO_INCREMENTAL", "0")
os.environ.setdefault("MBX_LEARNED_INCREMENTAL", "0")
os.environ.setdefault("MBX_EAGER_INCREMENTAL", "0")
MANIFEST = ROOT / "scripts/ci-cases.json"
BUILD = ROOT / "target/ci-build/manifest.json"
CASE_CPUS = 2
# Python projects with their own tests: the CI row that runs them and their `uv` extras.
PYTHON_PROJECTS = {
    "connectors": ("python-sdk", ["--all-extras"]),
    "examples/markdown-provider": ("python-example", []),
    "clients/python": ("python-client", []),
}


def selected_cases(cases):
    tier = os.environ.get("FYRR_CI_TIER", "full")
    if tier not in {"quick", "full"}:
        raise ValueError(f"unknown CI tier: {tier}")
    return {
        case: details
        for case, details in cases.items()
        if tier == "full" or details["tier"] == "quick"
    }


def case_seconds(details):
    # Python stays batched; individual Python durations are not measured.
    return details["seconds"] or 0


def build():
    """One Cargo selection per variant; all rows execute these exact artifacts."""
    result = {"root": str(ROOT), "tests": {}, "binaries": {}}
    for variant in ("full", "reader"):
        # Keep the workspace's dependency feature union identical. Selecting only
        # the reader package would rebuild Lance through different regex/JSON/
        # numeric features inherited from the writer's dependencies.
        args = ["--workspace", "--lib", "--bins", "--tests"]
        if variant == "reader":
            args.append("--no-default-features")
        messages = output(
            [
                "mbx",
                "test",
                "--locked",
                *args,
                "--no-run",
                "--message-format=json-render-diagnostics",
            ]
        )
        for line in messages.splitlines():
            item = json.loads(line)
            if item.get("reason") != "compiler-artifact" or not item.get("executable"):
                continue
            target = item["target"]
            package = tomllib.loads(Path(item["manifest_path"]).read_text())["package"]["name"]
            if item["profile"]["test"]:
                if variant == "reader" and (
                    package != "fyrr"
                    or target["kind"] != ["test"]
                    or target["name"] not in {"cli", "privacy"}
                ):
                    continue
                group = f"{variant}:{package}:{target['kind'][0]}:{target['name']}"
                result["tests"][group] = {
                    "path": str(Path(item["executable"]).relative_to(ROOT)),
                    "cwd": str(Path(item["manifest_path"]).parent.relative_to(ROOT)),
                }
            elif target["name"] == "fyrr":
                # Preserve immutable variants so concurrent harnesses never
                # replace the executable another case is about to launch.
                destination = BUILD.parent / variant / "fyrr"
                destination.parent.mkdir(parents=True, exist_ok=True)
                # Copy only a changed binary. Compare bytes: a cache restore
                # can keep size and mtime. The snapshot is a plain executable.
                temporary = destination.with_suffix(".tmp")
                temporary.unlink(missing_ok=True)
                filecmp.clear_cache()
                if (
                    destination.is_symlink()
                    or not os.access(destination, os.R_OK | os.X_OK)
                    or destination.stat().st_nlink > 1
                    or not filecmp.cmp(item["executable"], destination, shallow=False)
                ):
                    shutil.copy2(item["executable"], temporary)
                    temporary.replace(destination)
                result["binaries"][variant] = str(destination.relative_to(ROOT))
    if not {"full", "reader"} <= result["binaries"].keys():
        raise ValueError("Cargo did not produce every required binary")
    BUILD.write_text(json.dumps(result, indent=2) + "\n")


def artifacts():
    if os.environ.get("FYRR_CI_PREBUILT") != "1":
        build()
    result = json.loads(BUILD.read_text())
    if result["root"] != str(ROOT):
        raise ValueError("test binaries belong to another checkout; rebuild them")
    return result


def output(command, cwd=ROOT):
    environment = dict(os.environ)
    if command[0] == "mbx":
        environment.pop("RUSTC_WRAPPER", None)
    return subprocess.check_output(command, cwd=cwd, env=environment, text=True)


def rust_inventory(compiled):
    cases = {}
    for group, item in compiled["tests"].items():
        binary = str(ROOT / item["path"])
        for line in output([binary, "--list"]).splitlines():
            if line.endswith(": test"):
                name = line.removesuffix(": test")
                cases[f"{group}/{name}"] = False
    return cases


def python_inventory(directories):
    cases = {}
    for directory in directories:
        args = PYTHON_PROJECTS[directory][1]
        output(["uv", "sync", "--locked", *args], ROOT / directory)
        listing = output(
            ["uv", "run", "--locked", *args, "pytest", "--collect-only", "-q"],
            ROOT / directory,
        )
        for line in listing.splitlines():
            if "::" in line and not line.startswith(" "):
                cases[f"python:{directory}/{line}"] = False
    return cases


def inventory():
    return {**rust_inventory(artifacts()), **python_inventory(PYTHON_PROJECTS)}


def python_directories(spec):
    """The Python projects holding tests a row owns, as its prefixes and exceptions name them."""
    keys = [*spec.get("owns", {}), *spec.get("cases", {})]
    return [
        directory
        for directory in PYTHON_PROJECTS
        if any(
            key.startswith(f"python:{directory}/") or f"python:{directory}/".startswith(key)
            for key in keys
        )
    ]


def resolver(manifest):
    """Return `owner(case)`: (row, key, details) of an exact listing, else the longest prefix."""
    exact = {
        case: (row, case, details)
        for row, spec in manifest.items()
        for case, details in {**spec.get("cases", {}), **spec.get("children", {})}.items()
    }
    prefixes = sorted(
        (
            (prefix, row, details)
            for row, spec in manifest.items()
            for prefix, details in spec.get("owns", {}).items()
        ),
        key=lambda item: -len(item[0]),
    )

    def owner(case):
        if case in exact:
            return exact[case]
        return next(
            (
                (row, prefix, details)
                for prefix, row, details in prefixes
                if case.startswith(prefix)
            ),
            None,
        )

    return owner


def expand(manifest, actual):
    """Give every row its executable cases; also return the unowned cases and prefix hits."""
    owner = resolver(manifest)
    rows = {row: {**spec, "cases": {}} for row, spec in manifest.items()}
    unowned = []
    hits = collections.Counter()
    for case in sorted(actual):
        found = owner(case)
        if found is None:
            unowned.append(case)
            continue
        row, key, details = found
        hits[row, key] += 1
        if case not in manifest[row].get("children", {}):
            rows[row]["cases"][case] = details
    return rows, unowned, hits


def validate(manifest, actual):
    prefix_owners, case_owners = {}, {}
    for row, spec in manifest.items():
        if "backend" in spec:
            if spec["backend"] not in {"local", "s3"}:
                raise ValueError(f"unknown storage backend: {row}")
            if set(spec.get("services", [])) - {"keycloak"}:
                raise ValueError(f"unknown external service: {row}")
        if spec.get("kind") not in {"rust", "python"} or not spec.get("title"):
            raise ValueError(f"row needs its execution kind and title: {row}")
        if spec["kind"] == "python" and row not in {owner for owner, _ in PYTHON_PROJECTS.values()}:
            raise ValueError(f"row has no Python check in scripts/ci: {row}")
        owns, cases = spec.get("owns", {}), spec.get("cases", {})
        if not owns and not cases:
            raise ValueError(f"zero-case row: {row}")
        for prefix in owns:
            if not prefix.endswith(("/", "::")):
                raise ValueError(f"prefix must end at a test group or module boundary: {prefix}")
            if prefix in prefix_owners:
                raise ValueError(
                    f"duplicate prefix owner: {prefix}: {prefix_owners[prefix]} and {row}"
                )
            prefix_owners[prefix] = row
        for case, details in {**owns, **cases}.items():
            if case.startswith("python:") != (spec["kind"] == "python"):
                raise ValueError(f"case does not match its row kind: {row}")
            if details.get("tier") not in {"quick", "full"}:
                raise ValueError(f"case needs a quick or full tier: {case}")
            seconds = details.get("seconds")
            if seconds is None:
                if spec["kind"] != "python":
                    raise ValueError(f"Rust case needs its measured seconds: {case}")
            elif (
                isinstance(seconds, bool)
                or not isinstance(seconds, (float, int))
                or not math.isfinite(seconds)
                or seconds < 0
            ):
                raise ValueError(f"invalid case duration: {case}")
        for case in (*cases, *spec.get("children", {})):
            if case in case_owners:
                raise ValueError(f"duplicate owner: {case}: {case_owners[case]} and {row}")
            case_owners[case] = row
    # An exception only earns its line when its prefix would own the case differently.
    by_prefix = resolver({row: {"owns": spec.get("owns", {})} for row, spec in manifest.items()})
    for row, spec in manifest.items():
        for case, details in spec.get("cases", {}).items():
            found = by_prefix(case)
            if found and found[0] == row and found[2]["tier"] == details["tier"]:
                raise ValueError(
                    f"case is already owned by its prefix {found[1]}; remove it: {case}"
                )
    expanded, unowned, hits = expand(manifest, actual)
    for row, spec in manifest.items():
        for child, details in spec.get("children", {}).items():
            parents = details["parents"]
            if not parents or any(parent not in expanded[row]["cases"] for parent in parents):
                raise ValueError(f"child parent is not executed by {row}: {parents}")
            expected = (
                "quick"
                if any(expanded[row]["cases"][p]["tier"] == "quick" for p in parents)
                else "full"
            )
            if details.get("tier") != expected:
                raise ValueError(f"child tier differs from its executing parents: {child}")
    stale = sorted(
        [case for case in case_owners if case not in actual]
        + [prefix for prefix, row in prefix_owners.items() if not hits[row, prefix]]
    )
    if unowned or stale:
        raise ValueError(f"unowned cases: {unowned}\nstale cases and prefixes: {stale}")
    for row, spec in expanded.items():
        print(f"{row}: {len(spec['cases'])} cases, {len(spec.get('children', {}))} named children")
    print(f"ownership: {len(actual)} executable cases, each with exactly one owner")
    counts = collections.Counter(
        details["tier"]
        for spec in expanded.values()
        for details in [*spec["cases"].values(), *spec.get("children", {}).values()]
    )
    print(f"tiers: {counts['quick']} quick; {len(actual)} full ({counts['full']} additional)")


def outcomes(directory, cases):
    """Each Rust case's (status, passed, failed, ignored, reason), from libtest's `--logfile`.

    libtest writes one `<result> <name>` line per finished test to that file, apart
    from anything the tests print. A case without a line did not finish: it failed.
    A `<group>.error` file names a harness error in that binary's run, which fails
    every case of the run.
    """
    finished = {}
    for path in Path(directory).glob("*.libtest"):
        group = unquote(path.name.removesuffix(".libtest"))
        for line in path.read_text(errors="replace").splitlines():
            # A result may carry a message (`failed: …`); test names hold no spaces.
            finished[f"{group}/{line.rsplit(' ', 1)[-1]}"] = line.split(" ", 1)[0]
    errors = {
        unquote(path.name.removesuffix(".error")): path.read_text(errors="replace").strip()
        for path in Path(directory).glob("*.error")
    }
    table = {"ok": ("pass", 1, 0, 0), "ignored": ("pass", 0, 0, 1), "ignored:": ("pass", 0, 0, 1)}
    results = {}
    for case in cases:
        error = errors.get(case.split("/", 1)[0])
        result = finished.get(case)
        if error is None and result in table:
            results[case] = (*table[result], None)
        else:
            results[case] = ("FAIL", 0, 1, 0, error or f"libtest result: {result or 'none'}")
    return results


def run(spec, compiled=None):
    groups = collections.defaultdict(list)
    for case in spec["cases"]:
        group, name = case.split("/", 1) if not case.startswith("python:") else (None, None)
        if group is None:
            directory = next(d for d in PYTHON_PROJECTS if case.startswith(f"python:{d}/"))
            name = case.removeprefix(f"python:{directory}/")
            # Exact selectors preload conftests; isolate directories whose tests
            # import their local conftest module by name.
            parent = Path(name.split("::", 1)[0]).parent
            groups[f"python:{directory}:{parent}"].append(name)
        else:
            groups[group].append(name)
    rust = [case for case in spec["cases"] if not case.startswith("python:")]
    if rust:
        compiled = compiled or artifacts()
        logs = Path(os.environ.get("FYRR_CI_LOG_DIR") or tempfile.mkdtemp(prefix="fyrr-ci-"))
        for stale in [*logs.glob("*.libtest"), *logs.glob("*.error")]:
            stale.unlink()
    # Run every group even after one fails, so each case reports its result.
    failures = []
    for group, names in groups.items():
        env = dict(os.environ)
        python = group.startswith("python:")
        if python:
            directory = group.split(":")[1]
            extras = PYTHON_PROJECTS[directory][1]
            command = ["uv", "run", "--locked", *extras, "pytest", *names]
            cwd = ROOT / directory
        else:
            item = compiled["tests"][group]
            command = [
                str(ROOT / item["path"]),
                "--include-ignored",
                "--exact",
                f"--logfile={logs}/{quote(group, safe='')}.libtest",
                *names,
            ]
            cwd = ROOT / item["cwd"]
            env["FYRR_GATE_BINARY"] = str(ROOT / compiled["binaries"][group.split(":")[0]])
            if spec.get("batch") and "FYRR_TEST_TMP" in env:
                env["TMPDIR"] = env["FYRR_TEST_TMP"]
        try:
            failure = run_group(group, names, command, cwd, env, None if python else logs)
        except Exception as error:
            # A harness error fails every case of this run, even one libtest passed.
            failure = f"{group}: {type(error).__name__}: {error}"
            if not python:
                (logs / f"{quote(group, safe='')}.error").write_text(failure + "\n")
        if failure:
            failures.append(failure)
    if rust:
        # `scripts/ci` reads the row's counts from here: one per selected case.
        results = outcomes(logs, rust).values()
        totals = (sum(result[column] for result in results) for column in (1, 2, 3))
        (logs / "counts").write_text(" ".join(map(str, totals)) + "\n")
    if failures:
        raise RuntimeError("\n".join(failures))


def run_group(group, names, command, cwd, env, logs):
    """Run one test binary or pytest directory; return its test failure, if any.

    libtest inherits stdout, so its output never passes through this process and
    a child it leaves behind cannot hold the run open. pytest's summary line is
    read from a pipe, as bytes.
    """
    if logs is None:
        output = bytearray()
        with subprocess.Popen(
            command, cwd=cwd, env=env, stdout=subprocess.PIPE, stderr=subprocess.STDOUT
        ) as process:
            for line in process.stdout:
                sys.stdout.buffer.write(line)
                sys.stdout.buffer.flush()
                output += line
        if process.returncode:
            return f"{group}: {len(names)} selected cases, process exited {process.returncode}"
        counts = re.findall(r"(\d+) passed", output.decode(errors="replace"))
        if not counts or int(counts[-1]) != len(names):
            return f"{group}: expected {len(names)} passed cases, got {counts}"
        return None
    process = subprocess.Popen(command, cwd=cwd, env=env)
    process.wait()
    results = outcomes(logs, [f"{group}/{name}" for name in names])
    missing = [case for case, result in results.items() if result[0] != "pass"]
    if missing:
        return f"{group}: no passing libtest result for {missing}"
    if process.returncode:
        # Every selected case passed, so no case explains this exit.
        raise RuntimeError(f"process exited {process.returncode} after its cases passed")
    if env.get("FYRR_CI_KEEP_FIXTURES") != "1":
        # Only this completed harness owns these local fixture roots. Keep
        # failed runs intact, and never remove external-service data here.
        owned = re.compile(rf"(?:storage-)?(?:dense|fyrr-history)-{process.pid}-")
        removed = 0
        for directory in Path(env.get("FYRR_TEST_TMP", ROOT / "target/tmp")).iterdir():
            if owned.match(directory.name) and directory.is_dir() and not directory.is_symlink():
                shutil.rmtree(directory)
                removed += 1
        print(f"ci-fixtures: removed {removed} successful roots for harness {process.pid}")
    return None


async def pool(manifest, logs, jobs, rows):
    """Schedule independent parents; every worker owns its fixture and process.

    A `batch` row needs no fixture: one worker runs all its cases, in one
    test process per binary.
    """
    display_logs = logs.relative_to(ROOT) if logs.is_relative_to(ROOT) else logs
    selected = []
    for row in rows:
        cases = list(selected_cases(manifest[row]["cases"]))
        if manifest[row].get("batch") and cases:
            selected.append((row, cases))
        else:
            selected += [(row, [case]) for case in cases]
    selected.sort(
        key=lambda item: -sum(case_seconds(manifest[item[0]]["cases"][c]) for c in item[1])
    )
    plan = [
        {
            "row": row,
            "case": case,
            "tier": manifest[row]["cases"][case]["tier"],
            "status": "selected"
            if row in rows and case in selected_cases(manifest[row]["cases"])
            else "n/e",
        }
        for row, spec in manifest.items()
        if spec["kind"] == "rust"
        for case in spec["cases"]
    ]
    (logs / "case-plan.json").write_text(json.dumps(plan, indent=2) + "\n")
    capacity = asyncio.Semaphore(jobs)
    started = time.monotonic()
    results = collections.defaultdict(list)
    row_seconds = collections.defaultdict(float)
    broken = set()
    active = {}
    peaks = collections.defaultdict(int)

    async def sample_memory():
        # Sum resident memory over each owned process tree. Shared pages can be
        # counted twice; this is a conservative sizing signal, not physical PSS.
        page_kib = os.sysconf("SC_PAGE_SIZE") // 1024
        while True:
            processes = {}
            for entry in Path("/proc").iterdir():
                if not entry.name.isdigit():
                    continue
                try:
                    fields = (entry / "stat").read_text().rsplit(") ", 1)[1].split()
                    processes[int(entry.name)] = (
                        int(fields[1]),
                        int(fields[21]) * page_kib,
                    )
                except (FileNotFoundError, ProcessLookupError, PermissionError):
                    continue
            totals = collections.defaultdict(int)
            for pid, (_, rss) in processes.items():
                ancestor = pid
                while ancestor in processes and ancestor not in active:
                    ancestor = processes[ancestor][0]
                if ancestor in active:
                    totals[active[ancestor]] += rss
            for case, rss in totals.items():
                peaks[case] = max(peaks[case], rss)
            await asyncio.sleep(0.5)

    sampler = asyncio.create_task(sample_memory())
    task = asyncio.current_task()
    # A timeout signals the whole process group and `scripts/ci` forwards it:
    # cancel once, so the workers' cleanup below is not cut short.
    asyncio.get_running_loop().add_signal_handler(
        signal.SIGTERM, lambda: task.cancelling() or task.cancel()
    )

    async def execute(row, cases):
        async with capacity:
            key = hashlib.sha256("\n".join(cases).encode()).hexdigest()[:12]
            # Each attempt gets a fresh directory, so results that an earlier
            # pool or its orphaned worker writes never land in this one.
            (logs / row).mkdir(parents=True, exist_ok=True)
            directory = Path(tempfile.mkdtemp(prefix=f"{key}-", dir=logs / row))
            clock = directory / "offset-ms"
            clock.write_text("0")
            clock.chmod(0o600)
            environment = {
                **os.environ,
                "FYRR_CI_LOG_DIR": str(directory),
                "FYRR_FIXTURE_ID": f"ci-{os.getpid()}-{key}",
                "FYRR_CI_PREBUILT": "1",
                "FYRR_TEST_CLOCK_FILE": str(clock),
            }
            began = time.monotonic()
            with (directory / "runner.log").open("w") as output_log:
                process = await asyncio.create_subprocess_exec(
                    # Builds and cases of every checkout share the machine. A
                    # case that starts while compilers hold all cores runs
                    # several times slower and misses its deadlines, so each
                    # case takes its cores from the mbx scheduler first.
                    "mbx",
                    "reserve",
                    f"--cpus={CASE_CPUS}",
                    "--",
                    str(ROOT / "scripts/ci"),
                    f"--row={row}",
                    *(f"--case={case}" for case in cases),
                    cwd=ROOT,
                    env=environment,
                    stdout=output_log,
                    stderr=asyncio.subprocess.STDOUT,
                    start_new_session=True,
                )
                active[process.pid] = key
                stopped = True
                try:
                    await process.wait()
                    stopped = False
                finally:
                    if stopped:
                        # This process group was created above for this case only.
                        try:
                            os.killpg(process.pid, signal.SIGTERM)
                            await asyncio.wait_for(process.wait(), timeout=30)
                        except TimeoutError:
                            os.killpg(process.pid, signal.SIGKILL)
                            await process.wait()
                        except ProcessLookupError:
                            await process.wait()
                    active.pop(process.pid, None)
                    # Record what finished even when the pool is stopped.
                    duration = time.monotonic() - began
                    row_seconds[row] += duration
                    if process.returncode:
                        broken.add(row)
                    found = outcomes(directory, cases)
                    if (
                        not stopped
                        and process.returncode
                        and all(result[0] != "FAIL" for result in found.values())
                    ):
                        # No failed case explains this exit: none of the job's results stand.
                        found = dict.fromkeys(
                            found, ("FAIL", 0, 1, 0, f"worker exited {process.returncode}")
                        )
                    for case, (status, passed, failed, ignored, reason) in found.items():
                        result = {
                            "row": row,
                            "case": case,
                            "tier": manifest[row]["cases"][case]["tier"],
                            "peak_rss_kib": peaks[key],
                            "status": status,
                            "passed": passed,
                            "failed": failed,
                            "ignored": ignored,
                            # A batch has no per-case process to time.
                            "seconds": round(duration, 3) if len(cases) == 1 else None,
                            "elapsed_seconds": round(time.monotonic() - started, 3),
                            "finished_at": datetime.datetime.now(datetime.UTC).isoformat(),
                            "log": str(display_logs / row / directory.name / "runner.log"),
                        }
                        if reason:
                            result["reason"] = reason
                        results[row].append(result)
                        print("ci-result " + json.dumps(result), flush=True)

    try:
        await asyncio.gather(*(execute(row, cases) for row, cases in selected))
    finally:
        sampler.cancel()
        with contextlib.suppress(asyncio.CancelledError):
            await sampler
        # Write what is known even when the pool is stopped; a selected case
        # without a result failed.
        for row in rows:
            items = results[row]
            chosen = selected_cases(manifest[row]["cases"])
            for case in manifest[row]["cases"].keys() - {item["case"] for item in items}:
                items.append(
                    {
                        "row": row,
                        "case": case,
                        "tier": manifest[row]["cases"][case]["tier"],
                        "status": "FAIL" if case in chosen else "n/e",
                        "passed": 0,
                        "failed": int(case in chosen),
                        "ignored": 0,
                        "seconds": 0,
                        "reason": "not run" if case in chosen else "not selected by quick tier",
                    }
                )
            status = (
                "pass"
                if row not in broken and all(item["status"] in {"pass", "n/e"} for item in items)
                else "FAIL"
            )
            passed, failed, ignored = (
                sum(item[name] for item in items) for name in ("passed", "failed", "ignored")
            )
            seconds = round(row_seconds[row])
            (logs / row).mkdir(parents=True, exist_ok=True)
            path = logs / row / "cases.json"
            path.write_text(json.dumps(items, indent=2) + "\n")
            line = (
                f"{manifest[row]['title']:<38} {status:<5} {passed:7} {failed:7} {ignored:8} "
                f"{seconds:6}s  {display_logs / row / 'cases.json'}\n"
            )
            (logs / row / "summary.txt").write_text(line)


def main():
    os.chdir(ROOT)
    mode = sys.argv[1]
    if mode == "build":
        build()
        return
    if mode == "binary":
        compiled = artifacts()
        name = sys.argv[2]
        print(
            ROOT / compiled["binaries"][name]
            if name in ("full", "reader")
            else ROOT / compiled["tests"][name]["path"]
        )
        return
    if mode == "inventory":
        print(json.dumps(inventory(), indent=2, sort_keys=True))
        return
    manifest = json.loads(MANIFEST.read_text())
    if mode == "check":
        validate(manifest, inventory())
    elif mode == "metadata":
        for row, spec in manifest.items():
            print(f"{row}\t{spec['kind']}\t{spec['title']}")
    elif mode == "rows":
        # Rows with something to run in this tier, and whether a top-level run
        # skips them unless asked; no build needed to know.
        for row, spec in manifest.items():
            if spec["kind"] == "rust":
                entries = {**spec.get("owns", {}), **spec.get("cases", {})}
                print(f"{row}\t{len(selected_cases(entries))}\t{int(spec.get('on_demand', False))}")
    elif mode == "settings":
        spec = manifest[sys.argv[2]]
        print(json.dumps({"backend": spec.get("backend"), "services": spec.get("services", [])}))
    elif mode == "plan":
        for row, spec in expand(manifest, inventory())[0].items():
            for case, details in {**spec["cases"], **spec.get("children", {})}.items():
                print(f"{row}\t{spec.get('backend', 'core')}\t{details['tier']}\t{case}")
    elif mode == "pool":
        rows = expand(manifest, rust_inventory(artifacts()))[0]
        asyncio.run(pool(rows, Path(sys.argv[2]), int(sys.argv[3]), sys.argv[4:]))
    elif mode == "run":
        row = sys.argv[2]
        spec = manifest[row]
        compiled = None
        if len(sys.argv) > 3:
            cases, owner = {}, resolver(manifest)
            for case in sys.argv[3:]:
                found = owner(case)
                if not found or found[0] != row or case in spec.get("children", {}):
                    raise ValueError(f"case does not belong to the selected owner: {case}")
                cases[case] = found[2]
        else:
            if spec["kind"] == "python":
                actual = python_inventory(python_directories(spec))
            else:
                compiled = artifacts()
                actual = rust_inventory(compiled)
            cases = expand(manifest, actual)[0][row]["cases"]
        cases = selected_cases(cases)
        if not cases:
            raise ValueError("zero-case row")
        run({**spec, "cases": cases}, compiled)
    else:
        raise ValueError(f"unknown mode: {mode}")


if __name__ == "__main__":
    main()
