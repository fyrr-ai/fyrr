#!/usr/bin/env python3
"""Enumerate executable cases and run the committed, disjoint CI ownership rows."""

import asyncio
import collections
import contextlib
import datetime
import hashlib
import json
import math
import os
import re
import shutil
import signal
import subprocess
import sys
import time
import tomllib
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
os.environ["PATH"] = f"{Path.home() / '.cargo/bin'}:{os.environ['PATH']}"
os.environ["MBX_TARGET_VIEWS"] = "0"
os.environ.setdefault("MBX_GC_MAX_SIZE", "40GiB")
os.environ.setdefault("MBX_GC_MIN_FREE_SIZE", "12GiB")
os.environ.setdefault("CARGO_INCREMENTAL", "0")
os.environ.setdefault("MBX_LEARNED_INCREMENTAL", "0")
os.environ.setdefault("MBX_EAGER_INCREMENTAL", "0")
MANIFEST = ROOT / "scripts/ci-cases.json"
BUILD = ROOT / "target/ci-build/manifest.json"
CASE_CPUS = 2
# Python projects with their own tests: the CI row that runs them and their `uv` extras.
PYTHON_PROJECTS = {
    "connectors": ("python-sdk", ["--all-extras"]),
    "examples/markdown-provider": ("python-example", []),
    "clients/python": ("python-client", []),
}


def selected_cases(spec):
    tier = os.environ.get("FYRR_CI_TIER", "full")
    if tier not in {"quick", "full"}:
        raise ValueError(f"unknown CI tier: {tier}")
    return {
        case: details
        for case, details in spec["cases"].items()
        if tier == "full" or details["tier"] == "quick"
    }


def case_seconds(details):
    # Python stays batched; individual Python durations are not measured.
    return details["seconds"] or 0


def build():
    """One Cargo selection per variant; all rows execute these exact artifacts."""
    result = {"root": str(ROOT), "tests": {}, "binaries": {}}
    for variant in ("full", "reader"):
        # Keep the workspace's dependency feature union identical. Selecting only
        # the reader package would rebuild Lance through different regex/JSON/
        # numeric features inherited from the writer's dependencies.
        args = ["--workspace", "--lib", "--bins", "--tests"]
        if variant == "reader":
            args.append("--no-default-features")
        messages = output(
            [
                "mbx",
                "test",
                "--locked",
                *args,
                "--no-run",
                "--message-format=json-render-diagnostics",
            ]
        )
        for line in messages.splitlines():
            item = json.loads(line)
            if item.get("reason") != "compiler-artifact" or not item.get("executable"):
                continue
            target = item["target"]
            package = tomllib.loads(Path(item["manifest_path"]).read_text())["package"]["name"]
            if item["profile"]["test"]:
                if variant == "reader" and (
                    package != "fyrr"
                    or target["kind"] != ["test"]
                    or target["name"] not in {"cli", "privacy"}
                ):
                    continue
                group = f"{variant}:{package}:{target['kind'][0]}:{target['name']}"
                result["tests"][group] = {
                    "path": str(Path(item["executable"]).relative_to(ROOT)),
                    "cwd": str(Path(item["manifest_path"]).parent.relative_to(ROOT)),
                }
            elif target["name"] == "fyrr":
                # Preserve immutable variants so concurrent harnesses never
                # replace the executable another case is about to launch.
                destination = BUILD.parent / variant / "fyrr"
                destination.parent.mkdir(parents=True, exist_ok=True)
                temporary = destination.with_suffix(".tmp")
                shutil.copy2(item["executable"], temporary)
                temporary.replace(destination)
                result["binaries"][variant] = str(destination.relative_to(ROOT))
    if not {"full", "reader"} <= result["binaries"].keys():
        raise ValueError("Cargo did not produce every required binary")
    BUILD.write_text(json.dumps(result, indent=2) + "\n")


def artifacts():
    if os.environ.get("FYRR_CI_PREBUILT") != "1":
        build()
    result = json.loads(BUILD.read_text())
    if result["root"] != str(ROOT):
        raise ValueError("test binaries belong to another checkout; rebuild them")
    return result


def output(command, cwd=ROOT):
    environment = dict(os.environ)
    if command[0] == "mbx":
        environment.pop("RUSTC_WRAPPER", None)
    return subprocess.check_output(command, cwd=cwd, env=environment, text=True)


def rust_inventory(compiled):
    cases = {}
    for group, item in compiled["tests"].items():
        binary = str(ROOT / item["path"])
        for line in output([binary, "--list"]).splitlines():
            if line.endswith(": test"):
                name = line.removesuffix(": test")
                cases[f"{group}/{name}"] = False
    return cases


def inventory():
    cases = rust_inventory(artifacts())
    for directory, (_, args) in PYTHON_PROJECTS.items():
        output(["uv", "sync", "--locked", *args], ROOT / directory)
        listing = output(
            ["uv", "run", "--locked", *args, "pytest", "--collect-only", "-q"],
            ROOT / directory,
        )
        for line in listing.splitlines():
            if "::" in line and not line.startswith(" "):
                cases[f"python:{directory}/{line}"] = False
    return cases


def validate(manifest, actual):
    owners = {}
    for row, spec in manifest.items():
        if "backend" in spec:
            if spec["backend"] not in {"local", "s3"}:
                raise ValueError(f"unknown storage backend: {row}")
            if set(spec.get("services", [])) - {"keycloak"}:
                raise ValueError(f"unknown external service: {row}")
        if spec.get("kind") not in {"rust", "python"} or not spec.get("title"):
            raise ValueError(f"row needs its execution kind and title: {row}")
        if spec["kind"] == "python" and row not in {owner for owner, _ in PYTHON_PROJECTS.values()}:
            raise ValueError(f"row has no Python check in scripts/ci: {row}")
        if any(case.startswith("python:") != (spec["kind"] == "python") for case in spec["cases"]):
            raise ValueError(f"case does not match its row kind: {row}")
        if not spec["cases"]:
            raise ValueError(f"zero-case row: {row}")
        for case, details in spec["cases"].items():
            if details.get("tier") not in {"quick", "full"}:
                raise ValueError(f"case needs a quick or full tier: {case}")
            seconds = details.get("seconds")
            if seconds is None:
                if spec["kind"] != "python":
                    raise ValueError(f"Rust case needs its measured seconds: {case}")
            elif (
                isinstance(seconds, bool)
                or not isinstance(seconds, (float, int))
                or not math.isfinite(seconds)
                or seconds < 0
            ):
                raise ValueError(f"invalid case duration: {case}")
            if case in owners:
                raise ValueError(f"duplicate owner: {case}: {owners[case]} and {row}")
            owners[case] = row
        for child, details in spec.get("children", {}).items():
            parents = details["parents"]
            if child in owners:
                raise ValueError(f"duplicate child owner: {child}")
            if not parents or any(parent not in spec["cases"] for parent in parents):
                raise ValueError(f"child parent is not executed by {row}: {parents}")
            expected = (
                "quick" if any(spec["cases"][p]["tier"] == "quick" for p in parents) else "full"
            )
            if details.get("tier") != expected:
                raise ValueError(f"child tier differs from its executing parents: {child}")
            owners[child] = row
    missing = actual.keys() - owners.keys()
    stale = owners.keys() - actual.keys()
    if missing or stale:
        raise ValueError(f"unowned cases: {sorted(missing)}\nstale cases: {sorted(stale)}")
    for row, spec in manifest.items():
        print(f"{row}: {len(spec['cases'])} cases, {len(spec.get('children', {}))} named children")
    print(f"ownership: {len(owners)} executable cases, each with exactly one owner")
    counts = collections.Counter(
        details["tier"]
        for spec in manifest.values()
        for details in [*spec["cases"].values(), *spec.get("children", {}).values()]
    )
    print(f"tiers: {counts['quick']} quick; {len(owners)} full ({counts['full']} additional)")


def run(spec):
    groups = collections.defaultdict(list)
    for case in spec["cases"]:
        group, name = case.split("/", 1) if not case.startswith("python:") else (None, None)
        if group is None:
            directory = next(d for d in PYTHON_PROJECTS if case.startswith(f"python:{d}/"))
            name = case.removeprefix(f"python:{directory}/")
            # Exact selectors preload conftests; isolate directories whose tests
            # import their local conftest module by name.
            parent = Path(name.split("::", 1)[0]).parent
            groups[f"python:{directory}:{parent}"].append(name)
        else:
            groups[group].append(name)
    compiled = artifacts() if any(not g.startswith("python:") for g in groups) else None
    for group, names in groups.items():
        if group.startswith("python:"):
            directory = group.split(":")[1]
            extras = PYTHON_PROJECTS[directory][1]
            command = ["uv", "run", "--locked", *extras, "pytest", *names]
            cwd = ROOT / directory
        else:
            item = compiled["tests"][group]
            command = [str(ROOT / item["path"]), "--include-ignored", "--exact", *names]
            cwd = ROOT / item["cwd"]
        env = dict(os.environ)
        if not group.startswith("python:"):
            env["FYRR_GATE_BINARY"] = str(ROOT / compiled["binaries"][group.split(":")[0]])
        process = subprocess.Popen(
            command,
            cwd=cwd,
            env=env,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
        )
        lines = []
        started = last_finished = time.monotonic()
        pending = None
        for line in process.stdout:
            print(line, end="", flush=True)
            lines.append(line)
            if group.startswith("python:"):
                continue
            # libtest runs serially by default. A parent may print its child
            # harness output between `test NAME ...` and a standalone `ok`.
            header = re.match(r"^test (\S+) \.\.\. ?(.*)$", line.rstrip())
            if header and header[1] in names:
                pending = header[1]
                status = header[2]
            elif line.strip() in {"ok", "FAILED"}:
                status = line.strip()
            else:
                continue
            if pending is None or status not in {"ok", "FAILED"}:
                continue
            finished = time.monotonic()
            event = {
                "case": f"{group}/{pending}",
                "status": status,
                "finished_at": datetime.datetime.now(datetime.UTC).isoformat(),
                "elapsed_seconds": round(finished - started, 3),
            }
            if env.get("RUST_TEST_THREADS", "1") == "1":
                event["seconds"] = round(finished - last_finished, 3)
            print("ci-case " + json.dumps(event), flush=True)
            last_finished = finished
            pending = None
        if process.wait():
            raise RuntimeError(
                f"{group}: {len(names)} selected cases, process exited {process.returncode}"
            )
        transcript = "".join(lines)
        if group.startswith("python:"):
            counts = re.findall(r"(\d+) passed", transcript)
        else:
            counts = re.findall(r"test result: ok\. (\d+) passed;", transcript)
        if not counts or int(counts[-1]) != len(names):
            raise ValueError(f"{group}: expected {len(names)} passed cases, got {counts}")
        if not group.startswith("python:") and env.get("FYRR_CI_KEEP_FIXTURES") != "1":
            # Only this completed harness owns these local fixture roots. Keep
            # failed runs intact, and never remove external-service data here.
            owned = re.compile(rf"(?:storage-)?(?:dense|fyrr-history)-{process.pid}-")
            removed = 0
            for directory in (ROOT / "target/tmp").iterdir():
                if (
                    owned.match(directory.name)
                    and directory.is_dir()
                    and not directory.is_symlink()
                ):
                    shutil.rmtree(directory)
                    removed += 1
            print(f"ci-fixtures: removed {removed} successful roots for harness {process.pid}")


async def pool(manifest, logs, jobs, rows):
    """Schedule independent parents; every worker owns its fixture and process."""
    display_logs = logs.relative_to(ROOT) if logs.is_relative_to(ROOT) else logs
    selected = [(row, case) for row in rows for case in selected_cases(manifest[row])]
    selected.sort(key=lambda item: -case_seconds(manifest[item[0]]["cases"][item[1]]))
    plan = [
        {
            "row": row,
            "case": case,
            "tier": manifest[row]["cases"][case]["tier"],
            "status": "selected"
            if row in rows and case in selected_cases(manifest[row])
            else "n/e",
        }
        for row, spec in manifest.items()
        if spec["kind"] == "rust"
        for case in spec["cases"]
    ]
    (logs / "case-plan.json").write_text(json.dumps(plan, indent=2) + "\n")
    capacity = asyncio.Semaphore(jobs)
    started = time.monotonic()
    results = collections.defaultdict(list)
    active = {}
    peaks = collections.defaultdict(int)

    async def sample_memory():
        # Sum resident memory over each owned process tree. Shared pages can be
        # counted twice; this is a conservative sizing signal, not physical PSS.
        page_kib = os.sysconf("SC_PAGE_SIZE") // 1024
        while True:
            processes = {}
            for entry in Path("/proc").iterdir():
                if not entry.name.isdigit():
                    continue
                try:
                    fields = (entry / "stat").read_text().rsplit(") ", 1)[1].split()
                    processes[int(entry.name)] = (
                        int(fields[1]),
                        int(fields[21]) * page_kib,
                    )
                except (FileNotFoundError, ProcessLookupError, PermissionError):
                    continue
            totals = collections.defaultdict(int)
            for pid, (_, rss) in processes.items():
                ancestor = pid
                while ancestor in processes and ancestor not in active:
                    ancestor = processes[ancestor][0]
                if ancestor in active:
                    totals[active[ancestor]] += rss
            for case, rss in totals.items():
                peaks[case] = max(peaks[case], rss)
            await asyncio.sleep(0.5)

    sampler = asyncio.create_task(sample_memory())
    task = asyncio.current_task()
    asyncio.get_running_loop().add_signal_handler(signal.SIGTERM, task.cancel)

    async def execute(row, case):
        async with capacity:
            key = hashlib.sha256(case.encode()).hexdigest()[:12]
            directory = logs / row / key
            directory.mkdir(parents=True, exist_ok=True)
            clock = directory / "offset-ms"
            clock.write_text("0")
            clock.chmod(0o600)
            environment = {
                **os.environ,
                "FYRR_CI_LOG_DIR": str(directory),
                "FYRR_FIXTURE_ID": f"ci-{os.getpid()}-{key}",
                "FYRR_CI_PREBUILT": "1",
                "FYRR_TEST_CLOCK_FILE": str(clock),
            }
            began = time.monotonic()
            with (directory / "runner.log").open("w") as output_log:
                process = await asyncio.create_subprocess_exec(
                    # Builds and cases of every checkout share the machine. A
                    # case that starts while compilers hold all cores runs
                    # several times slower and misses its deadlines, so each
                    # case takes its cores from the mbx scheduler first.
                    "mbx",
                    "reserve",
                    f"--cpus={CASE_CPUS}",
                    "--",
                    str(ROOT / "scripts/ci"),
                    f"--row={row}",
                    f"--case={case}",
                    cwd=ROOT,
                    env=environment,
                    stdout=output_log,
                    stderr=asyncio.subprocess.STDOUT,
                    start_new_session=True,
                )
                active[process.pid] = case
                try:
                    code = await process.wait()
                finally:
                    if process.returncode is None:
                        # This process group was created above for this case only.
                        try:
                            os.killpg(process.pid, signal.SIGTERM)
                            await asyncio.wait_for(process.wait(), timeout=30)
                        except TimeoutError:
                            os.killpg(process.pid, signal.SIGKILL)
                            await process.wait()
                        except ProcessLookupError:
                            await process.wait()
                    active.pop(process.pid, None)
            duration = time.monotonic() - began
            title = manifest[row]["title"]
            summary = directory / "summary.txt"
            record = None
            if summary.exists():
                for line in summary.read_text().splitlines():
                    if not line.startswith(title + " "):
                        continue
                    record = re.match(
                        r"^.*?\s+(pass|FAIL)\s+(\d+)\s+(\d+)\s+(\d+)\s+(\d+)s\s+(.+)$",
                        line,
                    )
                    if record:
                        break
            status, passed, failed, ignored = ("FAIL", 0, 0, 0)
            if record:
                status = record[1] if code == 0 else "FAIL"
                passed, failed, ignored = map(int, record.group(2, 3, 4))
            result = {
                "row": row,
                "case": case,
                "tier": manifest[row]["cases"][case]["tier"],
                "peak_rss_kib": peaks[case],
                "status": status,
                "passed": passed,
                "failed": failed,
                "ignored": ignored,
                "seconds": round(duration, 3),
                "elapsed_seconds": round(time.monotonic() - started, 3),
                "finished_at": datetime.datetime.now(datetime.UTC).isoformat(),
                "log": str(display_logs / row / key / "runner.log"),
            }
            results[row].append(result)
            print("ci-result " + json.dumps(result), flush=True)

    try:
        await asyncio.gather(*(execute(row, case) for row, case in selected))
    finally:
        sampler.cancel()
        with contextlib.suppress(asyncio.CancelledError):
            await sampler
    for row in rows:
        items = results[row]
        for case in manifest[row]["cases"].keys() - selected_cases(manifest[row]).keys():
            items.append(
                {
                    "row": row,
                    "case": case,
                    "tier": "full",
                    "status": "n/e",
                    "passed": 0,
                    "failed": 0,
                    "ignored": 0,
                    "seconds": 0,
                    "reason": "not selected by quick tier",
                }
            )
        status = "pass" if all(item["status"] in {"pass", "n/e"} for item in items) else "FAIL"
        passed, failed, ignored = (
            sum(item[name] for item in items) for name in ("passed", "failed", "ignored")
        )
        seconds = round(sum(item["seconds"] for item in items))
        path = logs / row / "cases.json"
        path.write_text(json.dumps(items, indent=2) + "\n")
        line = (
            f"{manifest[row]['title']:<38} {status:<5} {passed:7} {failed:7} {ignored:8} "
            f"{seconds:6}s  {display_logs / row / 'cases.json'}\n"
        )
        (logs / row / "summary.txt").write_text(line)


def main():
    os.chdir(ROOT)
    mode = sys.argv[1]
    if mode == "build":
        build()
        return
    if mode == "binary":
        compiled = artifacts()
        name = sys.argv[2]
        print(
            ROOT / compiled["binaries"][name]
            if name in ("full", "reader")
            else ROOT / compiled["tests"][name]["path"]
        )
        return
    if mode == "inventory":
        print(json.dumps(inventory(), indent=2, sort_keys=True))
        return
    manifest = json.loads(MANIFEST.read_text())
    if mode == "check":
        validate(manifest, inventory())
    elif mode == "metadata":
        for row, spec in manifest.items():
            print(f"{row}\t{spec['kind']}\t{spec['title']}")
    elif mode == "rows":
        rows = [
            row
            for row, spec in manifest.items()
            if (
                spec["kind"] == "rust"
                if sys.argv[2] == "pool"
                else row.startswith(sys.argv[2] + "-")
            )
        ]
        for row in sorted(
            rows, key=lambda r: -sum(case_seconds(d) for d in selected_cases(manifest[r]).values())
        ):
            print(f"{row}\t{len(selected_cases(manifest[row]))}" if sys.argv[2] == "pool" else row)
    elif mode == "settings":
        spec = manifest[sys.argv[2]]
        print(json.dumps({"backend": spec.get("backend"), "services": spec.get("services", [])}))
    elif mode == "plan":
        for row, spec in manifest.items():
            for case, details in {**spec["cases"], **spec.get("children", {})}.items():
                print(f"{row}\t{spec.get('backend', 'core')}\t{details['tier']}\t{case}")
    elif mode == "pool":
        asyncio.run(pool(manifest, Path(sys.argv[2]), int(sys.argv[3]), sys.argv[4:]))
    elif mode == "run":
        spec = {**manifest[sys.argv[2]], "cases": selected_cases(manifest[sys.argv[2]])}
        if len(sys.argv) == 4:
            case = sys.argv[3]
            if case not in spec["cases"]:
                raise ValueError("case does not belong to the selected owner")
            spec = {**spec, "cases": {case: spec["cases"][case]}}
        if not spec["cases"]:
            raise ValueError("zero-case row")
        run(spec)
    else:
        raise ValueError(f"unknown mode: {mode}")


if __name__ == "__main__":
    main()
