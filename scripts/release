#!/usr/bin/env bash
# Assembles versioned release artifacts locally, from the same steps the
# repository already uses: the pinned release builds of both binaries
# and the connector SDK wheel
# (docker/Dockerfile builds it the same way), and the two images as
# scripts/images builds and tests them. This script uploads, pushes and tags
# nothing; on a `v*` tag, .github/workflows/release.yml runs CI and then
# publishes this script's output.
#
# Both binaries are compiled once (scripts/lib.sh release_binaries) and the
# images package those files. A build host whose glibc is newer than the
# runtime images' cannot do that: its binaries would not start in them. The
# images then compile their own binaries in the pinned builder stage, and
# manifest.txt records which happened as `image_binaries`.
#
#   scripts/release [--version V] [--out DIR] [--binaries DIR] [--no-images]
#                   [--prebuilt-images]
#
# --version V        artifact version (default: `git describe --tags --always`;
#                    a dirty tree is refused)
# --out DIR          output directory (default: target/release-artifacts)
# --binaries DIR     assemble from DIR/fyrr and DIR/fyrr-reader instead of
#                    compiling, for binaries built elsewhere from this commit
#                    (for example in docker/Dockerfile's builder stage)
# --no-images        skip the images (their row in manifest.txt is then n/e)
# --prebuilt-images  fail instead of compiling a second time for the images
#
# Output: DIR/fyrr-V/ with LICENSE and NOTICE, the full and reader-only
# binaries, the SDK wheel, the generated schemas and MCP fixtures (with
# LICENSE and NOTICE), the image archives, manifest.txt and SHA256SUMS.
# Binaries and image archives carry the build host's platform (linux-x86_64
# or linux-aarch64) in their names; scripts/release-combine joins the
# directories of several platforms into one release.
source "$(dirname "${BASH_SOURCE[0]}")/lib.sh"
cd "$ROOT"

VERSION=""
OUT="$ROOT/target/release-artifacts"
IMAGES=1
PREBUILT_ONLY=0
SUPPLIED=""
while (($#)); do
  case "$1" in
    --version) VERSION="$2"; shift 2 ;;
    --out) OUT="$(realpath -m -- "$2")"; shift 2 ;;
    --binaries)
      [[ -n "${2:-}" ]] || die "--binaries requires a directory"
      SUPPLIED="$(realpath -- "$2")"
      shift 2
      ;;
    --no-images) IMAGES=0; shift ;;
    --prebuilt-images) PREBUILT_ONLY=1; shift ;;
    *) die "unknown argument $1 (use --version V, --out DIR, --binaries DIR, --no-images, --prebuilt-images)" ;;
  esac
done

if [[ -z "$VERSION" ]]; then
  git -C "$ROOT" rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "not a git checkout; pass --version"
  [[ -z "$(git -C "$ROOT" status --porcelain)" ]] || die "the tree has uncommitted changes; commit them or pass --version"
  VERSION="$(git -C "$ROOT" describe --tags --always)"
fi
[[ "$VERSION" =~ ^[A-Za-z0-9][A-Za-z0-9.+_-]{0,63}$ ]] || die "version must be a bounded identifier"
COMMIT="$(git -C "$ROOT" rev-parse HEAD 2>/dev/null || echo unavailable)"
if tree_status="$(git -C "$ROOT" status --porcelain 2>/dev/null)"; then
  [[ -z "$tree_status" ]] && TREE_STATE=clean || TREE_STATE=dirty
else
  TREE_STATE=unavailable
fi
BUILD_OS="$(if [[ -r /etc/os-release ]]; then (source /etc/os-release; printf '%s %s' "${ID:-unknown}" "${VERSION_ID:-unknown}"); else echo unavailable; fi)"
BUILD_GLIBC="$(getconf GNU_LIBC_VERSION 2>/dev/null || echo unavailable)"
[[ "$(uname -s)" == Linux ]] || die "release artifacts are built on Linux only"
case "$(uname -m)" in
  x86_64 | aarch64) PLATFORM="linux-$(uname -m)" ;;
  *) die "release artifacts are built on x86-64 and aarch64 only" ;;
esac
DIR="$OUT/fyrr-$VERSION"
LOGS="$ROOT/target/release-logs/$VERSION"

rm -rf "$DIR"
mkdir -p "$DIR"
mkdir -p "$LOGS"
log "assembling fyrr $VERSION in ${DIR#"$ROOT"/}"

"$ROOT/scripts/doctor" >"$LOGS/doctor.log" 2>&1 || { tail -n 20 "$LOGS/doctor.log"; die "scripts/doctor failed"; }

# Runtime facts come from the exported ELF, not the build host's libc version.
binary_runtime() {
  local binary="$1" dynamic headers symbols glibc interpreter needed rpath runpath
  dynamic="$(LC_ALL=C readelf --dynamic "$binary")" || return 1
  headers="$(LC_ALL=C readelf --program-headers --wide "$binary")" || return 1
  symbols="$(LC_ALL=C readelf --version-info "$binary")" || return 1
  glibc="$(sed -nE 's/.*Name: GLIBC_([0-9.]+).*/\1/p' <<<"$symbols" | sort -Vu | tail -n1)" || return 1
  interpreter="$(sed -nE 's/.*Requesting program interpreter: ([^]]*)].*/\1/p' <<<"$headers")" || return 1
  needed="$(sed -n 's/.*(NEEDED).*\[\(.*\)\]/\1/p' <<<"$dynamic" | paste -sd, -)" || return 1
  rpath="$(sed -n 's/.*(RPATH).*\[\(.*\)\]/\1/p' <<<"$dynamic")" || return 1
  runpath="$(sed -n 's/.*(RUNPATH).*\[\(.*\)\]/\1/p' <<<"$dynamic")" || return 1
  if [[ -n "$rpath$runpath" ]]; then
    echo "release binary $(basename "$binary") embeds a runtime search path" >&2
    return 1
  fi
  printf 'binary_runtime %s\n' "$(basename "$binary")"
  printf '  glibc_symbols_max %s\n' "${glibc:-none}"
  printf '  interpreter %s\n' "${interpreter:-none}"
  printf '  needed %s\n' "${needed:-none}"
  printf '  rpath %s\n  runpath %s\n' "${rpath:-none}" "${runpath:-none}"
}

# --- binaries (the shipping release profile) ------------------
BINARIES="$ROOT/target/release-binaries"
rm -rf "$BINARIES"
if [[ -n "$SUPPLIED" ]]; then
  log "using the binaries in $SUPPLIED"
  mkdir -p "$BINARIES"
  for binary in fyrr fyrr-reader; do
    [[ -f "$SUPPLIED/$binary" ]] || die "$SUPPLIED/$binary is missing"
    install -m 0755 "$SUPPLIED/$binary" "$BINARIES/$binary"
    if LC_ALL=C grep -aFq 'FYRR_TEST_CLOCK_FILE' "$BINARIES/$binary"; then
      die "shipping binary contains the test clock hook"
    fi
  done
else
  release_binaries "$BINARIES"
fi
install -m 0755 "$BINARIES/fyrr" "$DIR/fyrr-$VERSION-$PLATFORM"
install -m 0755 "$BINARIES/fyrr-reader" "$DIR/fyrr-reader-$VERSION-$PLATFORM"
full_runtime="$(binary_runtime "$DIR/fyrr-$VERSION-$PLATFORM")" || die "cannot inspect full binary runtime"
reader_runtime="$(binary_runtime "$DIR/fyrr-reader-$VERSION-$PLATFORM")" || die "cannot inspect reader binary runtime"
# The full binary embeds no Python: it must not need libpython, and it runs
# without any interpreter on the host.
if grep -qi 'libpython' <<<"$full_runtime"; then die "the full binary needs libpython"; fi
env -i "$DIR/fyrr-$VERSION-$PLATFORM" --version | grep -q 'full build' || die "the full binary does not report the full build"
"$DIR/fyrr-reader-$VERSION-$PLATFORM" --version | grep -q 'reader-only build' || die "the reader binary does not report the reader-only build"

# --- the connector SDK wheel ------------------------------------------------
log "building the connector SDK wheel"
rm -rf "$DIR/wheel-build"
uv build --wheel --quiet --out-dir "$DIR/wheel-build" "$ROOT/connectors"
wheel="$(ls "$DIR"/wheel-build/fyrr_connectors-*.whl)"
mv "$wheel" "$DIR/"
rm -rf "$DIR/wheel-build"
wheel="$DIR/$(basename "$wheel")"

# --- license and contracts --------------------------------------------------
cp "$ROOT/LICENSE" "$ROOT/NOTICE" "$DIR/"
tar -czf "$DIR/fyrr-contracts-$VERSION.tar.gz" -C "$ROOT" LICENSE NOTICE schemas fixtures/contracts fixtures/mcp

# --- images (built and tested by scripts/images) ------------------------------
image_row="images  n/e  (--no-images)"
image_tag=""
image_binaries=""
if ((IMAGES)); then
  needed_glibc="$(printf '%s\n%s\n' "$full_runtime" "$reader_runtime" | awk '$1 == "glibc_symbols_max" {print $2}' | sort -V | tail -n1)"
  if [[ "$(printf '%s\n%s\n' "$needed_glibc" "$IMAGE_GLIBC" | sort -V | tail -n1)" == "$IMAGE_GLIBC" ]]; then
    image_binaries=release
    image_source=(--binaries "$BINARIES")
    log "packaging and testing both images from the release binaries with scripts/images"
  else
    ((!PREBUILT_ONLY)) || die "the release binaries need glibc $needed_glibc; the runtime images have $IMAGE_GLIBC (--prebuilt-images)"
    image_binaries=builder
    image_source=()
    log "the release binaries need glibc $needed_glibc, newer than the runtime images' $IMAGE_GLIBC: scripts/images compiles in the builder stage"
  fi
  "$ROOT/scripts/images" "${image_source[@]}" >"$LOGS/images.log" 2>&1 || { tail -n 30 "$LOGS/images.log"; die "scripts/images failed (log: ${LOGS#"$ROOT"/}/images.log)"; }
  image_tag="$(worktree_image_tag)"
  docker image save "fyrr:$image_tag" | gzip >"$DIR/fyrr-image-$VERSION-$PLATFORM.tar.gz"
  docker image save "fyrr-reader:$image_tag" | gzip >"$DIR/fyrr-reader-image-$VERSION-$PLATFORM.tar.gz"
  image_row="images  pass  fyrr-image-$VERSION-$PLATFORM.tar.gz fyrr-reader-image-$VERSION-$PLATFORM.tar.gz ($(cat "$ROOT/target/images/sizes.txt" | tr '\n' ';'))"
fi

# --- manifest and sums --------------------------------------------------------
{
  echo "fyrr $VERSION"
  echo "commit $COMMIT"
  echo "platform $PLATFORM"
  # The build host's facts describe only binaries this run compiled.
  if [[ -n "$SUPPLIED" ]]; then
    echo "binary_build supplied"
    echo "working_tree $TREE_STATE"
  else
    echo "binary_build host"
    echo "working_tree $TREE_STATE"
    echo "build_os $BUILD_OS"
    echo "build_libc $BUILD_GLIBC"
  fi
  echo "$full_runtime"
  echo "$reader_runtime"
  echo "built_at $(date -u +%FT%TZ)"
  echo "rustc $(rustc --version)"
  echo "sdk $(basename "$wheel")"
  echo "$image_row"
  if [[ -n "$image_tag" ]]; then
    echo "image_tag $image_tag"
    echo "image_binaries $image_binaries"
  fi
  echo
  echo "size  file"
  for file in "$DIR"/*; do
    [[ -f "$file" && "$(basename "$file")" != manifest.txt ]] || continue
    printf '%d  %s\n' "$(stat -c %s "$file")" "$(basename "$file")"
  done
} >"$DIR/manifest.txt"
(cd "$DIR" && sha256sum -- * >SHA256SUMS && sha256sum --check --quiet SHA256SUMS)
log "done: ${DIR#"$ROOT"/} ($(grep -c . "$DIR/SHA256SUMS") files, SHA256SUMS verified); nothing was published"
cat "$DIR/manifest.txt"
